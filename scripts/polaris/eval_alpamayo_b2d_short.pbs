#!/bin/sh
#PBS -l select=2:ngpus=4
#PBS -l walltime=1:00:00
#PBS -q preemptable
#PBS -A RobustViT
#PBS -l filesystems=home:eagle
#PBS -j oe
#PBS -o logs/polaris_eval_alpamayo_b2d_short.out

# Short (1-route) Alpamayo-R1 closed-loop Bench2Drive evaluation on Polaris.
# Node 0 runs CARLA (carla.sif); node 1 runs the lead Alpamayo agent (lead.sif),
# producing a 4-camera input video. Mirrors USAGE.md section 5.

set -eu

REPO_DIR=${REPO_DIR:-/eagle/RobustViT/hiratsuka/VLA4AD_Research}

ml use /soft/modulefiles
ml spack-pe-base
ml apptainer

cd "${REPO_DIR}"
exec bash scripts/polaris/eval_alpamayo_b2d_short.sh
