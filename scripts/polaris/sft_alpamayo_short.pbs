#!/bin/sh
#PBS -l select=1:ngpus=4
#PBS -l walltime=2:00:00
#PBS -q preemptable
#PBS -A RobustViT
#PBS -l filesystems=home:eagle
#PBS -j oe
#PBS -o logs/polaris_sft_alpamayo_short.out

# Short (1-step) Alpamayo-R1 SFT verification on Polaris using the production
# train_hf path (sft_stage1 / sft_stage2). Not a smoke model: full 10B checkpoint,
# real PAI data, real configs. Only the step count is reduced for verification.
# DeepSpeed ZeRO-3 + CPU offload is used so the 10B model fits on 4x A100 40GB.

set -eu

REPO_DIR=${REPO_DIR:-/eagle/RobustViT/hiratsuka/VLA4AD_Research}
IMAGE_DIR=${IMAGE_DIR:-${REPO_DIR}/containers}
ALPAMAYO_SIF=${ALPAMAYO_SIF:-${IMAGE_DIR}/alpamayo.sif}
WS=/workspace/VLA4AD_Research

STAGE=${STAGE:-all}
NPROC=${NPROC:-4}
PAI_DIR=${PAI_DIR:-${WS}/data/carla_alpamayo_pai}
CKPT=${CKPT:-${WS}/outputs/checkpoints/Alpamayo-R1-10B}
OUT_ROOT=${OUT_ROOT:-${WS}/outputs/alpamayo_sft_polaris}
CHUNK_IDS=${CHUNK_IDS:-0-1}
MAX_STEPS=${MAX_STEPS:-1}
# Stage 1 (full 10B VLM finetune) needs ZeRO-2 + CPU optimizer offload to fit on
# 4x A100 40GB. ZeRO-3 cannot be used because Alpamayo loads VLM weights with a
# plain load_state_dict, which is incompatible with ZeRO-3's deferred (size-0)
# param init. Stage 2 trains only the (small) action expert with the VLM frozen,
# so it uses the production setting (deepspeed: null / DDP) unchanged.
DEEPSPEED_STAGE1=${DEEPSPEED_STAGE1:-finetune/sft/configs/deepspeed/zero2_offload.json}
# Stage 2's production default (deepspeed: null / DDP) replicates the full 10B
# VLM on every GPU and OOMs on 40GB. Use ZeRO-2 + CPU offload and turn on
# gradient checkpointing to fit. (ZeRO-3 would shard params but breaks Alpamayo's
# manual weight loading, same as Stage 1.)
DEEPSPEED_STAGE2=${DEEPSPEED_STAGE2:-finetune/sft/configs/deepspeed/zero2_offload.json}

ml use /soft/modulefiles
ml spack-pe-base
ml apptainer

cd "${REPO_DIR}"
mkdir -p logs outputs/alpamayo_sft_polaris outputs/hf_home

if [ ! -f "${ALPAMAYO_SIF}" ]; then
    echo "Missing Alpamayo image: ${ALPAMAYO_SIF}" >&2
    echo "Run: qsub scripts/polaris/build_alpamayo.pbs" >&2
    exit 2
fi

HF_TOKEN_VAL=$(grep -E '^HF_TOKEN=' .env 2>/dev/null | cut -d= -f2- || true)

run_alpamayo() {
    apptainer exec --nv \
        --env HF_HOME=${WS}/outputs/hf_home \
        --env HF_TOKEN="${HF_TOKEN_VAL}" \
        --env HF_HUB_OFFLINE=1 \
        --env TRANSFORMERS_OFFLINE=1 \
        --env WANDB_DISABLED=true \
        --env TOKENIZERS_PARALLELISM=false \
        --env OMP_NUM_THREADS=8 \
        --env PYTHONUNBUFFERED=1 \
        --env HYDRA_FULL_ERROR=1 \
        --env PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True \
        -B "${REPO_DIR}:${WS}" \
        "${ALPAMAYO_SIF}" \
        "$@"
}

STAGE1_OUT=${OUT_ROOT}/stage1
STAGE2_OUT=${OUT_ROOT}/stage2

if [ "${STAGE}" = "all" ] || [ "${STAGE}" = "1" ]; then
    echo "[$(date -u '+%FT%TZ')] === Stage 1 (VLM SFT, 1 step) ==="
    run_alpamayo alpamayo-torchrun --nproc_per_node "${NPROC}" -m finetune.sft.train_hf \
        --config-path pkg://finetune/sft/configs \
        --config-name sft_stage1 \
        data.train_dataset.local_dir="${PAI_DIR}" \
        data.val_dataset.local_dir="${PAI_DIR}" \
        data.train_dataset.chunk_ids="${CHUNK_IDS}" \
        data.val_dataset.chunk_ids="${CHUNK_IDS}" \
        data.train_dataset.use_default_keyframe=false \
        data.val_dataset.use_default_keyframe=false \
        model.checkpoint_path="${CKPT}" \
        paths.output_dir="${STAGE1_OUT}" \
        trainer.deepspeed="${DEEPSPEED_STAGE1}" \
        +trainer.max_steps="${MAX_STEPS}" \
        trainer.num_train_epochs=1 \
        trainer.save_steps=1
fi

if [ "${STAGE}" = "all" ] || [ "${STAGE}" = "2" ]; then
    STAGE1_CKPT=${STAGE1_CKPT:-${STAGE1_OUT}/checkpoint-${MAX_STEPS}}
    echo "[$(date -u '+%FT%TZ')] === Stage 2 (action expert, 1 step) using ${STAGE1_CKPT} ==="
    run_alpamayo alpamayo-torchrun --nproc_per_node "${NPROC}" -m finetune.sft.train_hf \
        --config-path pkg://finetune/sft/configs \
        --config-name sft_stage2 \
        data.train_dataset.local_dir="${PAI_DIR}" \
        data.val_dataset.local_dir="${PAI_DIR}" \
        data.train_dataset.chunk_ids="${CHUNK_IDS}" \
        data.val_dataset.chunk_ids="${CHUNK_IDS}" \
        data.train_dataset.use_default_keyframe=false \
        data.val_dataset.use_default_keyframe=false \
        model.pretrained_model_name_or_path="${CKPT}" \
        model.stage1_vlm_checkpoint_path="${STAGE1_CKPT}" \
        paths.output_dir="${STAGE2_OUT}" \
        ${DEEPSPEED_STAGE2:+trainer.deepspeed="${DEEPSPEED_STAGE2}"} \
        +trainer.max_steps="${MAX_STEPS}" \
        trainer.num_train_epochs=1 \
        trainer.save_steps=1
fi

echo "[$(date -u '+%FT%TZ')] === SFT verification done ==="
find "${OUT_ROOT}" -maxdepth 2 -name "checkpoint-*" -type d 2>/dev/null
