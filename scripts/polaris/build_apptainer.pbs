#!/bin/sh
#PBS -l select=1
#PBS -l walltime=1:00:00
#PBS -q debug
#PBS -A RobustViT
#PBS -l filesystems=home:eagle
#PBS -j oe
#PBS -o logs/polaris_build_apptainer.out

set -eu

REPO_DIR=${REPO_DIR:-/eagle/RobustViT/hiratsuka/VLA4AD_Research}
IMAGE_DIR=${IMAGE_DIR:-${REPO_DIR}/containers}

ml use /soft/modulefiles
ml spack-pe-base
ml apptainer

export HTTP_PROXY=${HTTP_PROXY:-http://proxy.alcf.anl.gov:3128}
export HTTPS_PROXY=${HTTPS_PROXY:-http://proxy.alcf.anl.gov:3128}
export http_proxy=${http_proxy:-${HTTP_PROXY}}
export https_proxy=${https_proxy:-${HTTPS_PROXY}}
export APPTAINER_CACHEDIR=${APPTAINER_CACHEDIR:-${REPO_DIR}/.apptainer/cache}
export APPTAINER_TMPDIR=${APPTAINER_TMPDIR:-/tmp/${USER}/vla4ad-apptainer}

mkdir -p "${IMAGE_DIR}" "${APPTAINER_CACHEDIR}" "${APPTAINER_TMPDIR}" "${REPO_DIR}/logs"
cd "${REPO_DIR}"

if [ ! -f "${IMAGE_DIR}/carla.sif" ] || [ "${FORCE_REBUILD:-0}" = "1" ] || [ "${FORCE_CARLA:-0}" = "1" ]; then
    echo "[$(date -u '+%Y-%m-%dT%H:%M:%SZ')] Building CARLA image"
    apptainer build --fakeroot --force "${IMAGE_DIR}/carla.sif" carla.def
else
    echo "[$(date -u '+%Y-%m-%dT%H:%M:%SZ')] Reusing ${IMAGE_DIR}/carla.sif"
fi

if [ ! -f "${IMAGE_DIR}/lead.sif" ] || [ "${FORCE_REBUILD:-0}" = "1" ] || [ "${FORCE_LEAD:-0}" = "1" ]; then
    echo "[$(date -u '+%Y-%m-%dT%H:%M:%SZ')] Building LEAD image"
    apptainer build --fakeroot --force "${IMAGE_DIR}/lead.sif" lead.def
else
    echo "[$(date -u '+%Y-%m-%dT%H:%M:%SZ')] Reusing ${IMAGE_DIR}/lead.sif"
fi

echo "[$(date -u '+%Y-%m-%dT%H:%M:%SZ')] Done"
ls -lh "${IMAGE_DIR}/carla.sif" "${IMAGE_DIR}/lead.sif"
