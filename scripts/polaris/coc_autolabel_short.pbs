#!/bin/sh
#PBS -l select=1:ngpus=4
#PBS -l walltime=2:00:00
#PBS -q preemptable
#PBS -A RobustViT
#PBS -l filesystems=home:eagle
#PBS -j oe
#PBS -o logs/polaris_coc_autolabel_short.out

# End-to-end CoC autolabeling verification on the existing CARLA->PAI clips, using
# the real NVlabs autolabeler pipeline (meta-action -> keyframe -> video -> CoC VLM).
# CoC backend defaults to qwen3.5_27b_fp8 (4x A100 40GB, vLLM tensor-parallel).

set -eu

REPO_DIR=${REPO_DIR:-/eagle/RobustViT/hiratsuka/VLA4AD_Research}
IMAGE_DIR=${IMAGE_DIR:-${REPO_DIR}/containers}
COC_SIF=${COC_SIF:-${IMAGE_DIR}/coc_autolabeler.sif}
WS=/workspace/VLA4AD_Research

STAGE=${STAGE:-all}
MODEL_NAME=${MODEL_NAME:-qwen3.5_27b_fp8}

ml use /soft/modulefiles
ml spack-pe-base
ml apptainer

# ALCF proxy so vLLM/HF can pull the Qwen weights on the compute node.
export HTTP_PROXY=${HTTP_PROXY:-http://proxy.alcf.anl.gov:3128}
export HTTPS_PROXY=${HTTPS_PROXY:-http://proxy.alcf.anl.gov:3128}
export http_proxy=${http_proxy:-${HTTP_PROXY}}
export https_proxy=${https_proxy:-${HTTPS_PROXY}}

HF_TOKEN=$(grep -E '^HF_TOKEN=' "${REPO_DIR}/.env" 2>/dev/null | cut -d= -f2- || true)

cd "${REPO_DIR}"
mkdir -p logs

echo "[$(date -u '+%Y-%m-%dT%H:%M:%SZ')] CoC autolabel STAGE=${STAGE} MODEL=${MODEL_NAME}"

apptainer exec --nv --writable-tmpfs \
  -B "${REPO_DIR}:${WS}" \
  --env HTTP_PROXY="${HTTP_PROXY}" --env HTTPS_PROXY="${HTTPS_PROXY}" \
  --env http_proxy="${http_proxy}" --env https_proxy="${https_proxy}" \
  --env HF_TOKEN="${HF_TOKEN}" \
  --env STAGE="${STAGE}" \
  --env MODEL_NAME="${MODEL_NAME}" \
  --env COC_VISIBLE_DEVICES="${COC_VISIBLE_DEVICES:-}" \
  --env NVIDIA_DRIVER_CAPABILITIES=all \
  "${COC_SIF}" \
  bash "${WS}/scripts/polaris/coc_autolabel_short.sh"

echo "[$(date -u '+%Y-%m-%dT%H:%M:%SZ')] Done"
