#!/bin/sh
# Parallel Py123D data collection: N server+client pairs on separate nodes.
#
# Default: 4 pairs = 8 nodes (override with qsub -l select=...).
#
# Required variable (pass via -v):
#   ROUTES_FILE  path to a text file with one route XML path per line
#
# Optional variables (pass via -v):
#   N_PAIRS      number of parallel pairs (default: number of lines in ROUTES_FILE)
#   OUTPUT_ROOT  output directory relative to REPO_DIR (default: data)
#   BASE_PORT    first RPC port; each scenario uses BASE_PORT + id*10 (default: 20000)
#
# Examples:
#   # 4-pair job (8 nodes) with a custom routes file:
#   qsub -v ROUTES_FILE=data/data_routes/lead/noScenarios/my_routes.txt \
#        scripts/polaris/collect_py123d_parallel.pbs
#
#   # 8-pair job (16 nodes):
#   qsub -l select=16:ngpus=4 \
#        -v N_PAIRS=8,ROUTES_FILE=data/data_routes/lead/noScenarios/my_routes.txt \
#        scripts/polaris/collect_py123d_parallel.pbs
#
#PBS -l select=8:ngpus=4
#PBS -l walltime=4:00:00
#PBS -q prod
#PBS -A RobustViT
#PBS -l filesystems=home:eagle
#PBS -j oe
#PBS -o logs/polaris_collect_py123d_parallel.out

set -eu

REPO_DIR=${REPO_DIR:-/eagle/RobustViT/hiratsuka/VLA4AD_Research}

ml use /soft/modulefiles
ml spack-pe-base
ml apptainer

cd "${REPO_DIR}"

if [ -z "${ROUTES_FILE:-}" ]; then
    echo "ERROR: ROUTES_FILE is not set." >&2
    echo "  Submit with: qsub -v ROUTES_FILE=<path> scripts/polaris/collect_py123d_parallel.pbs" >&2
    exit 2
fi

exec bash scripts/polaris/collect_py123d_parallel.sh
