Bootstrap: docker
From: python:3.7-slim-bullseye

%files
    .carla_wheels /opt/wheels

%post
    set -eux
    export DEBIAN_FRONTEND=noninteractive
    ls -la /opt/wheels
    pip install --no-cache-dir numpy /opt/wheels/carla-0.9.15-cp37-cp37m-manylinux_2_27_x86_64.whl
    python -c "import carla; print('carla cp37 import OK')"

%runscript
    exec python "$@"
