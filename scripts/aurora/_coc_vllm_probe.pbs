#!/bin/bash
#PBS -l select=1
#PBS -l walltime=1:00:00
#PBS -q debug
#PBS -A RobustViT
#PBS -l filesystems=home:flare
#PBS -j oe
#PBS -o logs/aurora_coc_vllm_probe.out

# Probe: can an Aurora-XPU vLLM (frameworks module, OpenAI server on :50000)
# accept the CoC autolabeler's remote multimodal request format?
# Boots Qwen3-VL-2B on one tile, then runs scripts/aurora/_coc_vllm_probe.py.
# NB: no `set -u` (Aurora lmod init references unbound vars).
set -eo pipefail

REPO_DIR=${REPO_DIR:-/lus/flare/projects/RobustViT/hiratsuka/VLA4AD_Research}
MODEL_PATH=${MODEL_PATH:-${REPO_DIR}/outputs/models/Qwen3-VL-2B-Instruct}
MODEL_NAME_SERVED=${MODEL_NAME_SERVED:-Qwen/Qwen3-VL-2B-Instruct}
PORT=${PORT:-50000}
MAX_MODEL_LEN=${MAX_MODEL_LEN:-32768}
MODEL_ARCH=${MODEL_ARCH:-Qwen3VLForConditionalGeneration}
export VLLM_CACHE_ROOT=${VLLM_CACHE_ROOT:-${REPO_DIR}/outputs/vllm_cache}

module use /soft/modulefiles
module load frameworks

# Aurora XPU vLLM env (per ALCF docs/aurora/data-science/inference/vllm).
export CCL_PROCESS_LAUNCHER=hydra
export ZE_FLAT_DEVICE_HIERARCHY=FLAT
export TMPDIR=/tmp
export RAY_TMPDIR=/tmp
export HF_HUB_OFFLINE=1
export TRANSFORMERS_OFFLINE=1
# ALCF proxy so the modelinfo prepopulation can load plugins; localhost stays direct.
export HTTP_PROXY=${HTTP_PROXY:-http://proxy.alcf.anl.gov:3128}
export HTTPS_PROXY=${HTTPS_PROXY:-http://proxy.alcf.anl.gov:3128}
export http_proxy=${http_proxy:-${HTTP_PROXY}}
export https_proxy=${https_proxy:-${HTTPS_PROXY}}
export no_proxy="localhost,127.0.0.1,${no_proxy:-}"
export NO_PROXY="${no_proxy}"

cd "${REPO_DIR}"
mkdir -p logs "${VLLM_CACHE_ROOT}"
SERVER_LOG="${REPO_DIR}/logs/aurora_coc_vllm_probe_server.log"

# Aurora XPU known issue: the first-time modelinfo inspection runs in a subprocess
# that SIGSEGVs (validation error for ModelConfig). Pre-populate the cache in-process
# once per VLLM_CACHE_ROOT (ALCF WA script). HF_HUB_OFFLINE must be off for plugin load.
echo "[$(date -u '+%FT%TZ')] prepopulating vLLM modelinfo cache for ${MODEL_ARCH} (VLLM_CACHE_ROOT=${VLLM_CACHE_ROOT})"
HF_HUB_OFFLINE=0 TRANSFORMERS_OFFLINE=0 \
  python "${REPO_DIR}/scripts/aurora/_wa/vllm_build_all_modelinfo_caches.py" --arch "${MODEL_ARCH}" || {
    echo "modelinfo prepopulation failed"; exit 6; }

echo "[$(date -u '+%FT%TZ')] launching vLLM server (Qwen3-VL-2B, 1 tile) on :${PORT}"
python -m vllm.entrypoints.openai.api_server \
  --model "${MODEL_PATH}" \
  --served-model-name "${MODEL_NAME_SERVED}" \
  --port "${PORT}" \
  --dtype float16 \
  --max-model-len "${MAX_MODEL_LEN}" \
  --tensor-parallel-size 1 \
  --trust-remote-code \
  > "${SERVER_LOG}" 2>&1 &
SERVER_PID=$!

cleanup() {
  echo "[$(date -u '+%FT%TZ')] stopping vLLM server (pid ${SERVER_PID})"
  kill "${SERVER_PID}" 2>/dev/null || true
  wait "${SERVER_PID}" 2>/dev/null || true
}
trap cleanup EXIT

echo "[$(date -u '+%FT%TZ')] waiting for server /v1/models (up to 20 min)..."
READY=0
for i in $(seq 1 240); do
  if ! kill -0 "${SERVER_PID}" 2>/dev/null; then
    echo "server process died early; tail of server log:"; tail -n 60 "${SERVER_LOG}"; exit 4
  fi
  if curl -s "http://127.0.0.1:${PORT}/v1/models" 2>/dev/null | grep -q "${MODEL_NAME_SERVED}"; then
    READY=1; break
  fi
  sleep 5
done
if [ "${READY}" != "1" ]; then
  echo "server not ready in time; tail of server log:"; tail -n 80 "${SERVER_LOG}"; exit 5
fi
echo "[$(date -u '+%FT%TZ')] server ready; running probe"

PORT="${PORT}" MODEL_NAME_SERVED="${MODEL_NAME_SERVED}" \
  python "${REPO_DIR}/scripts/aurora/_coc_vllm_probe.py"
PROBE_RC=$?

echo "[$(date -u '+%FT%TZ')] === probe done (rc=${PROBE_RC}) ==="
echo "----- server log tail -----"; tail -n 40 "${SERVER_LOG}"
exit "${PROBE_RC}"
