#!/bin/bash
#PBS -l select=1
#PBS -l walltime=1:00:00
#PBS -q debug
#PBS -A RobustViT
#PBS -l filesystems=home:flare
#PBS -j oe
#PBS -o logs/aurora_coc_autolabel.out

# CoC (Chain-of-Causation) autolabeling on Aurora for data/carla_alpamayo_pai.
#
# Aurora has Intel XPU (no NVIDIA GPU), so the CoC VLM (stage 4) runs as a native
# vLLM OpenAI server on the XPU host (frameworks module), and the autolabeler
# pipeline (stages 1-3 CPU + stage 4 as a remote client) runs inside
# containers/coc_autolabeler.sif. Both share the node's network, so the container
# reaches the server at 127.0.0.1:50000 (port fixed by chat_utils_local_server.py).
#
# Small verification by default (CLIP_LIST=logs/coc_verify_cliplist.txt). For the
# full dataset drop CLIP_LIST and move to a longer queue:
#   qsub -q capacity -l walltime=12:00:00 -v CLIP_LIST= scripts/aurora/coc_autolabel.pbs
# NB: no `set -u` (Aurora lmod init references unbound vars).
set -eo pipefail

REPO_DIR=${REPO_DIR:-/lus/flare/projects/RobustViT/hiratsuka/VLA4AD_Research}
WS=/workspace/VLA4AD_Research
COC_SIF=${COC_SIF:-${REPO_DIR}/containers/coc_autolabeler.sif}
# CoC VLM. Production = qwen3_vl_32b (dense, TP=2); qwen3_vl_2b is the 1-tile smoke.
# Registered in the autolabeler QWEN_MODEL_SPECS; the served name must equal the
# remote wrapper's hf id so the request model name matches.
COC_MODEL=${COC_MODEL:-qwen3_vl_32b}
case "${COC_MODEL}" in
  qwen3_vl_2b)  MODEL_DIR=Qwen3-VL-2B-Instruct;  MODEL_NAME_SERVED=Qwen/Qwen3-VL-2B-Instruct;  TP=${TP:-1} ;;
  qwen3_vl_8b)  MODEL_DIR=Qwen3-VL-8B-Instruct;  MODEL_NAME_SERVED=Qwen/Qwen3-VL-8B-Instruct;  TP=${TP:-1} ;;
  qwen3_vl_32b) MODEL_DIR=Qwen3-VL-32B-Instruct; MODEL_NAME_SERVED=Qwen/Qwen3-VL-32B-Instruct; TP=${TP:-2} ;;
  *) echo "Unknown COC_MODEL=${COC_MODEL} (qwen3_vl_2b|qwen3_vl_8b|qwen3_vl_32b)"; exit 2 ;;
esac
MODEL_PATH=${MODEL_PATH:-${REPO_DIR}/outputs/models/${MODEL_DIR}}
MODEL_ARCH=${MODEL_ARCH:-Qwen3VLForConditionalGeneration}
PORT=50000                                                          # fixed by autolabeler client
MAX_MODEL_LEN=${MAX_MODEL_LEN:-32768}
MM_IMAGE_LIMIT=${MM_IMAGE_LIMIT:-32}                                # CoC sends ~16 frames/segment as images
ENFORCE_EAGER=${ENFORCE_EAGER:-1}                                   # skip inductor compile (too slow on XPU for 32B)
RAY_NUM_GPUS=${RAY_NUM_GPUS:-12}                                    # expose ALL tiles to Ray; TP picks a subset (ALCF recipe)
STAGE=${STAGE:-all}
# Only the CoC VLM stage needs the GPU server; meta/keyframe/video/prep are CPU-only.
case "${STAGE}" in all|coc) NEEDS_SERVER=1 ;; *) NEEDS_SERVER=0 ;; esac
# PAI dataset (repo-relative). Verification uses a 3-clip subset because trajdata
# preprocesses EVERY clip in the dir before any scene-list filter; the full run
# points this at data/carla_alpamayo_pai.
PAI_DIR=${PAI_DIR:-data/carla_alpamayo_pai_verify}
# Working dir (repo-relative) for trajdata cache / meta / keyframes / videos / CoC
# outputs. Use a fresh dir per dataset — the trajdata cache is keyed by dataset name,
# so reusing a subset's cache shadows the full dataset.
WORK=${WORK:-outputs/coc_autolabel_aurora}
# Fixed CoC output dir (repo-relative) for resumable full runs; empty => new dir each run.
RESUME_DIR=${RESUME_DIR:-}
# Relative to the repo root; becomes a container path below. Empty => all clips in PAI_DIR.
CLIP_LIST=${CLIP_LIST:-}
export VLLM_CACHE_ROOT=${VLLM_CACHE_ROOT:-${REPO_DIR}/outputs/vllm_cache}

cd "${REPO_DIR}"
mkdir -p logs "${VLLM_CACHE_ROOT}"
SERVER_LOG="${REPO_DIR}/logs/aurora_coc_autolabel_server.log"

# ---- Stage 4 backend: native vLLM OpenAI server on the XPU host ----
module use /soft/modulefiles
module load frameworks
FW_PYTHON=$(command -v python)   # capture BEFORE loading apptainer (which shadows python)
echo "[$(date -u '+%FT%TZ')] frameworks python: ${FW_PYTHON}"

export CCL_PROCESS_LAUNCHER=hydra
export ZE_FLAT_DEVICE_HIERARCHY=FLAT
export TMPDIR=/tmp RAY_TMPDIR=/tmp
export HTTP_PROXY=${HTTP_PROXY:-http://proxy.alcf.anl.gov:3128}
export HTTPS_PROXY=${HTTPS_PROXY:-http://proxy.alcf.anl.gov:3128}
export http_proxy=${http_proxy:-${HTTP_PROXY}} https_proxy=${https_proxy:-${HTTPS_PROXY}}
export no_proxy="localhost,127.0.0.1,${no_proxy:-}" NO_PROXY="${no_proxy}"
# 32B load + XPU init across tiles can exceed vLLM's 600s engine-ready default.
export VLLM_ENGINE_READY_TIMEOUT_S=${VLLM_ENGINE_READY_TIMEOUT_S:-1800}

RAY_STARTED=0
if [ "${NEEDS_SERVER}" = "1" ]; then
# Aurora XPU: pre-populate the modelinfo cache in-process (first-time inspection
# otherwise SIGSEGVs in a subprocess). Idempotent; once per VLLM_CACHE_ROOT.
echo "[$(date -u '+%FT%TZ')] prepopulating modelinfo cache for ${MODEL_ARCH}"
HF_HUB_OFFLINE=0 "${FW_PYTHON}" "${REPO_DIR}/scripts/aurora/_wa/vllm_build_all_modelinfo_caches.py" \
  --arch "${MODEL_ARCH}" || { echo "modelinfo prepopulation failed"; exit 6; }

# TP>1 on Aurora needs a Ray cluster over the node's tiles (ALCF vLLM guide).
if [ "${TP}" -gt 1 ]; then
  export VLLM_HOST_IP=$(getent hosts "$(hostname).hsn.cm.aurora.alcf.anl.gov" | awk '{print $1}' | tr ' ' '\n' | sort | head -n 1)
  export TORCH_LLM_ALLREDUCE=1 CCL_ZE_IPC_EXCHANGE=drmfd
  # Ray's XPU manager needs explicit level_zero device indices (the module's
  # ONEAPI_DEVICE_SELECTOR=opencl:gpu;level_zero:gpu wildcard makes `ray start
  # --num-gpus` fail: "ONEAPI_DEVICE_SELECTOR contains ['gpu']"). Expose ALL tiles
  # (0..11 with ZE_FLAT_DEVICE_HIERARCHY=FLAT) and let Ray give each of the TP
  # workers its own tile — exposing only TP tiles breaks Ray's per-worker
  # isolation and deadlocks the collective init.
  export ONEAPI_DEVICE_SELECTOR="level_zero:$(seq -s, 0 $((RAY_NUM_GPUS - 1)))"
  echo "[$(date -u '+%FT%TZ')] starting Ray head (${RAY_NUM_GPUS} tiles, ${ONEAPI_DEVICE_SELECTOR}) at ${VLLM_HOST_IP}"
  ray start --head --node-ip-address="${VLLM_HOST_IP}" --port=6379 \
    --num-cpus=64 --num-gpus="${RAY_NUM_GPUS}" >> "${SERVER_LOG}" 2>&1
  RAY_STARTED=1
fi

DIST_ARG=""
[ "${TP}" -gt 1 ] && DIST_ARG="--distributed-executor-backend ray"
[ "${ENFORCE_EAGER}" = "1" ] && DIST_ARG="${DIST_ARG} --enforce-eager"
echo "[$(date -u '+%FT%TZ')] launching vLLM server (${COC_MODEL}, TP=${TP}) on :${PORT}"
# shellcheck disable=SC2086
HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 "${FW_PYTHON}" -m vllm.entrypoints.openai.api_server \
  --model "${MODEL_PATH}" \
  --served-model-name "${MODEL_NAME_SERVED}" \
  --port "${PORT}" \
  --dtype float16 \
  --max-model-len "${MAX_MODEL_LEN}" \
  --tensor-parallel-size "${TP}" \
  --max-num-seqs 1 \
  --limit-mm-per-prompt "{\"image\": ${MM_IMAGE_LIMIT}}" \
  ${DIST_ARG} \
  --trust-remote-code \
  >> "${SERVER_LOG}" 2>&1 &
SERVER_PID=$!

cleanup() {
  echo "[$(date -u '+%FT%TZ')] stopping vLLM server (pid ${SERVER_PID})"
  kill "${SERVER_PID}" 2>/dev/null || true
  wait "${SERVER_PID}" 2>/dev/null || true
  [ "${RAY_STARTED}" = "1" ] && ray stop >/dev/null 2>&1 || true
}
trap cleanup EXIT

echo "[$(date -u '+%FT%TZ')] waiting for server /v1/models (up to ~35 min)..."
READY=0
for i in $(seq 1 420); do
  if ! kill -0 "${SERVER_PID}" 2>/dev/null; then
    echo "server died early; server log tail:"; tail -n 80 "${SERVER_LOG}"; exit 4
  fi
  if curl -s "http://127.0.0.1:${PORT}/v1/models" 2>/dev/null | grep -q "${MODEL_NAME_SERVED}"; then
    READY=1; break
  fi
  sleep 5
done
[ "${READY}" = "1" ] || { echo "server not ready; log tail:"; tail -n 100 "${SERVER_LOG}"; exit 5; }
echo "[$(date -u '+%FT%TZ')] server ready"
else
  echo "[$(date -u '+%FT%TZ')] STAGE=${STAGE} is CPU-only; skipping vLLM server"
fi

# ---- Pipeline (stages 1-3 CPU + stage 4 remote) inside coc_autolabeler.sif ----
module load apptainer
CLIP_LIST_ARG=""
[ -n "${CLIP_LIST}" ] && CLIP_LIST_ARG="${WS}/${CLIP_LIST}"

# Bad-clip fix: bind our clamped trajdata pai_dataset.py over the container copy so
# a single clip with out-of-range ego timestamps no longer SIGKILLs meta-action
# preprocessing (needed for the full dataset). Container path from the traceback.
TRAJDATA_PAI=/usr/local/lib/python3.10/dist-packages/trajdata/dataset_specific/pai/pai_dataset.py
PAI_PATCH_BIND=""
[ -f "${REPO_DIR}/scripts/aurora/_wa/pai_dataset.patched.py" ] && \
  PAI_PATCH_BIND="-B ${REPO_DIR}/scripts/aurora/_wa/pai_dataset.patched.py:${TRAJDATA_PAI}"

echo "[$(date -u '+%FT%TZ')] running CoC pipeline STAGE=${STAGE} PAI_DIR=${PAI_DIR} CLIP_LIST='${CLIP_LIST_ARG:-<all clips in PAI_DIR>}'"
apptainer exec --writable-tmpfs \
  -B "${REPO_DIR}:${WS}" \
  ${PAI_PATCH_BIND} \
  --env STAGE="${STAGE}" \
  --env MODEL_NAME="${COC_MODEL}" \
  --env SERVER_IP=127.0.0.1 \
  --env PAI_DIR="${WS}/${PAI_DIR}" \
  --env WORK="${WS}/${WORK}" \
  --env RESUME_DIR="${RESUME_DIR:+${WS}/${RESUME_DIR}}" \
  --env CLIP_LIST="${CLIP_LIST_ARG}" \
  --env no_proxy="localhost,127.0.0.1" --env NO_PROXY="localhost,127.0.0.1" \
  "${COC_SIF}" \
  bash "${WS}/scripts/aurora/coc_autolabel.sh"

echo "[$(date -u '+%FT%TZ')] === Aurora CoC autolabel done ==="
