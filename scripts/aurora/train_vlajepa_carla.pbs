#!/bin/sh
#PBS -l select=1
#PBS -l walltime=1:00:00
#PBS -q debug
#PBS -A RobustViT
#PBS -l filesystems=home:flare
#PBS -j oe
#PBS -o logs/aurora_train_vlajepa_carla.out

# Train VLA-JEPA on the CARLA (PAI->LeRobot) dataset on Aurora Intel XPU.
#
# Defaults run a short smoke (few steps). Override via qsub -v, e.g.:
#   qsub -v MAX_STEPS=30000,NPROC=12,BS=1 scripts/aurora/train_vlajepa_carla.pbs
set -eu

REPO_DIR=${REPO_DIR:-/lus/flare/projects/RobustViT/hiratsuka/VLA4AD_Research}
IMAGE=${IMAGE:-${REPO_DIR}/containers/vlajepa.sif}

NPROC=${NPROC:-1}            # XPU tiles to use (1 tile = smoke; Aurora node has 12)
MAX_STEPS=${MAX_STEPS:-5}    # optimizer steps
BS=${BS:-1}                  # per-device batch size
CONFIG=${CONFIG:-scripts/config/vlajepa_carla_ft.yaml}
ACCEL_CONFIG=${ACCEL_CONFIG:-starVLA/config/deepseeds/deepspeed_zero2.yaml}

module use /soft/modulefiles || true
module load apptainer

cd "${REPO_DIR}"
mkdir -p logs outputs/vlajepa_carla

# Intel XPU / oneCCL runtime knobs for a single Aurora node.
export APPTAINERENV_VLAJEPA_AMP_DEVICE=xpu
export APPTAINERENV_HF_HOME=/workspace/VLA4AD_Research/outputs/hf_home
export APPTAINERENV_HF_HUB_OFFLINE=1
export APPTAINERENV_TRANSFORMERS_OFFLINE=1
export APPTAINERENV_ZE_FLAT_DEVICE_HIERARCHY=FLAT
export APPTAINERENV_CCL_ZE_IPC_EXCHANGE=sockets
export APPTAINERENV_ACCELERATE_USE_XPU=true

echo "[$(date -u '+%Y-%m-%dT%H:%M:%SZ')] Training VLA-JEPA/CARLA  NPROC=${NPROC} MAX_STEPS=${MAX_STEPS} BS=${BS}"

apptainer exec \
  --bind "${REPO_DIR}:/workspace/VLA4AD_Research" \
  --bind /dev/dri \
  "${IMAGE}" \
  bash -lc "cd /workspace/VLA4AD_Research/3rd_party/VLA-JEPA && \
    accelerate launch \
      --config_file ${ACCEL_CONFIG} \
      --num_processes ${NPROC} \
      --num_machines 1 \
      starVLA/training/train_starvla.py \
      --config_yaml ${CONFIG} \
      trainer.max_train_steps=${MAX_STEPS} \
      trainer.save_interval=${MAX_STEPS} \
      trainer.num_warmup_steps=0 \
      datasets.vla_data.per_device_batch_size=${BS}"

echo "[$(date -u '+%Y-%m-%dT%H:%M:%SZ')] === VLA-JEPA/CARLA training done ==="
