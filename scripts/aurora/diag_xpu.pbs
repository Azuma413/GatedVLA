#!/bin/bash
#PBS -l select=1
#PBS -l walltime=0:20:00
#PBS -q debug
#PBS -A RobustViT
#PBS -l filesystems=home:flare
#PBS -j oe
#PBS -o logs/aurora_diag_xpu.out

REPO_DIR=${REPO_DIR:-/lus/flare/projects/RobustViT/hiratsuka/VLA4AD_Research}
IMAGE=${IMAGE:-${REPO_DIR}/containers/vlajepa.sif}
cd "${REPO_DIR}" || exit 1
module load apptainer 2>/dev/null

FILTER='overriding|dispatch key|new kernel|previous kernel|operator:|warning only|_validate_compressed'

test_dev () {
  python -c "import torch; print('ct xpu avail', torch.xpu.is_available()); print('ct xpu count', torch.xpu.device_count())" 2>&1 | grep -viE "$FILTER"
}
export -f test_dev

run_ct () {
  local label="$1"; shift
  echo ""; echo "############ ${label} ############"
  apptainer exec "$@" "${IMAGE}" bash -lc 'echo "driver via ZE_ENABLE_ALT_DRIVERS=$ZE_ENABLE_ALT_DRIVERS"; '"$(declare -f test_dev)"'; test_dev' 2>&1 | grep -viE "$FILTER"
}

# Bind host /usr/lib64 (Aurora GPU driver stack) to /opt/host-lib64 (read-only),
# APPEND it to LD_LIBRARY_PATH so container libs win, and force the host GPU
# Level-Zero driver via ZE_ENABLE_ALT_DRIVERS.
HOSTLIB=/opt/host-lib64

run_ct "E: ALT_DRIVERS + host lib64 appended" \
  --bind /dev/dri --bind /usr/lib64:${HOSTLIB}:ro \
  --env LD_LIBRARY_PATH="/usr/local/lib:/usr/lib/x86_64-linux-gnu:${HOSTLIB}" \
  --env ZE_ENABLE_ALT_DRIVERS=${HOSTLIB}/libze_intel_gpu.so.1 \
  --env ZE_FLAT_DEVICE_HIERARCHY=FLAT

run_ct "F: ALT_DRIVERS + host lib64 prepended" \
  --bind /dev/dri --bind /usr/lib64:${HOSTLIB}:ro \
  --env LD_LIBRARY_PATH="${HOSTLIB}:/usr/local/lib" \
  --env ZE_ENABLE_ALT_DRIVERS=${HOSTLIB}/libze_intel_gpu.so.1 \
  --env ZE_FLAT_DEVICE_HIERARCHY=FLAT

echo ""; echo "############ DONE ############"
