#!/bin/bash
#PBS -l select=1
#PBS -l walltime=24:00:00
#PBS -q capacity
#PBS -A RobustViT
#PBS -l filesystems=home:flare
#PBS -j oe
#PBS -o logs/aurora_sft_alpamayo15.out

# Alpamayo-1.5-10B navigation+CoC SFT on the CARLA PAI dataset, on ONE Aurora
# node (12 XPU tiles), using the native `frameworks` module + venv + mpiexec/xccl
# (the CUDA/IPEX container cannot see Aurora's XPUs; see aurora-xpu-distributed).
# This is the Alpamayo 1.5 recipe (alpamayo1_5_sft.train_hf), NOT the older R1
# recipe (sft_alpamayo.pbs). torchrun segfaults with oneCCL on Aurora, so we
# launch one rank per tile via mpiexec and init xccl in alpamayo15_xpu_entry.py.
#
#   Stage 1: VLM SFT — image + past traj + nav command -> CoC + discrete traj
#            tokens (nav_cot processor). DeepSpeed ZeRO-2 shards optimizer across
#            12 tiles. Effective batch 36 = 12 tiles x BS1 x ACCUM1, 2 epochs.
#   Stage 2: trajectory diffusion expert (VLM frozen). DDP (no ZeRO). Effective
#            batch 12 = 12 tiles x 1 x 1, 3 epochs.
#
# Effective batch 32/8 (as originally specced) is not divisible by 12 tiles, so
# we round to the nearest 12-multiple (36/12) and keep all 12 tiles busy.
#
# The A1-format checkpoint's config.json says flash_attention_2 (CUDA only); we
# build a non-destructive `-xpu` view (symlinks + patched config.json) so both
# stages load with ${ATTN_IMPL} (eager) on XPU and resolve the base VLM locally.
#
# Logs go to W&B project `alpamayo15-carla-sft` (report_to=wandb; key from .env).
#   qsub scripts/aurora/sft_alpamayo15.pbs                 # both stages
#   qsub -v STAGE=1 scripts/aurora/sft_alpamayo15.pbs      # stage 1 only
#   qsub -v STAGE=2 scripts/aurora/sft_alpamayo15.pbs      # stage 2 only
#   # micro-batch probe (does mb3/no-accum fit? -> a few steps, no save/wandb):
#   qsub -v STAGE=1,BS1=3,ACCUM1=1,MAX_STEPS=4,SAVE_STRATEGY=no,REPORT_TO=none \
#        scripts/aurora/sft_alpamayo15.pbs
# NB: no `set -u` (Aurora lmod init references unbound vars).
set -eo pipefail

REPO_DIR=${REPO_DIR:-/lus/flare/projects/RobustViT/hiratsuka/VLA4AD_Research}
VENV=${VENV:-${REPO_DIR}/outputs/alpamayo15_venv}
RECIPES=${REPO_DIR}/3rd_party/alpamayo-recipes
SFT=${RECIPES}/recipes/alpamayo1_5_sft

STAGE=${STAGE:-all}
NPROC=${NPROC:-12}          # total XPU tiles (1 node = 12)
PPN=${PPN:-${NPROC}}

# per-device (per-tile) micro batch + grad accum -> effective batch.
# Stage 1 eff = 12*BS1*ACCUM1 = 36 (default mb1 x accum3; probe mb3 x accum1).
BS1=${BS1:-1};   ACCUM1=${ACCUM1:-3}
# Stage 2 eff = 12*BS2*ACCUM2 = 12.
BS2=${BS2:-1};   ACCUM2=${ACCUM2:-1}
EPOCHS1=${EPOCHS1:-2}
EPOCHS2=${EPOCHS2:-3}
WARMUP1=${WARMUP1:-50}      # stage1_nav default 500 is too high for ~600 steps
MAX_STEPS=${MAX_STEPS:-0}   # >0 caps steps (probe/smoke); 0 = full (epoch-driven)
SAVE_STRATEGY=${SAVE_STRATEGY:-epoch}
SAVE_STEPS=${SAVE_STEPS:-500}
LOG_STEPS=${LOG_STEPS:-5}
REPORT_TO=${REPORT_TO:-wandb}

PAI_DIR=${PAI_DIR:-${REPO_DIR}/data/carla_alpamayo_pai}
ANNOTATIONS=${ANNOTATIONS:-${PAI_DIR}/nav_coc_annotations.json}
TRAIN_CHUNKS=${TRAIN_CHUNKS:-0-48}     # all 48 chunks (range string; [start,end))
# A1-format checkpoint (produced by prepare_ckpt_alpamayo15.sh).
CKPT=${CKPT:-${REPO_DIR}/outputs/checkpoints/Alpamayo-1.5-10B-A1-format}
QWEN_DIR=${QWEN_DIR:-${REPO_DIR}/outputs/models/Qwen3-VL-8B-Instruct}
ATTN_IMPL=${ATTN_IMPL:-eager}   # flash_attention_2 CUDA-only; sdpa can NaN on XPU
OUT_ROOT=${OUT_ROOT:-${REPO_DIR}/outputs/alpamayo15_sft_aurora}
WANDB_PROJECT_NAME=${WANDB_PROJECT_NAME:-alpamayo15-carla-sft}
DS_ZERO2=${DS_ZERO2:-${SFT}/configs/deepspeed/zero2.json}

module use /soft/modulefiles
module load frameworks
# shellcheck disable=SC1091
source "${VENV}/bin/activate"

cd "${REPO_DIR}"
mkdir -p logs "${OUT_ROOT}"

# --- credentials + networking (online W&B + HF via ALCF proxy) ---
if [ -f "${REPO_DIR}/.env" ]; then set -a; . "${REPO_DIR}/.env"; set +a; fi
export https_proxy=${https_proxy:-http://proxy.alcf.anl.gov:3128}
export http_proxy=${http_proxy:-http://proxy.alcf.anl.gov:3128}
export WANDB_PROJECT="${WANDB_PROJECT_NAME}"
[ -n "${WANDB_API_KEY:-}" ] && export WANDB_API_KEY
[ -n "${HF_TOKEN:-}" ] && export HF_TOKEN
# save_pretrained may rebuild a default config that eagerly touches the HF hub;
# keep the proxy available (do not force offline). Local paths still win.
export HF_HOME=${REPO_DIR}/outputs/hf_home
export TOKENIZERS_PARALLELISM=false

export PYTHONUNBUFFERED=1
export HYDRA_FULL_ERROR=1
# alpamayo_r1 action-space geometry solves force fp32 via autocast guards written
# for CUDA; on XPU those are no-ops (bf16 rhs vs fp32 Cholesky factor -> dtype
# mismatch in cholesky_solve). Tell them to disable *XPU* autocast instead.
export ALPAMAYO_AUTOCAST_DEVICE=${ALPAMAYO_AUTOCAST_DEVICE:-xpu}
export PYTHONPATH="${REPO_DIR}/3rd_party/alpamayo/src:${RECIPES}/src:${RECIPES}/recipes:${PYTHONPATH:-}"
# 12 ranks/node each spawn dataloader workers + BLAS threads; cap intra-op threads.
export OMP_NUM_THREADS=${OMP_NUM_THREADS:-4}
export MKL_NUM_THREADS=${MKL_NUM_THREADS:-4}
export OPENBLAS_NUM_THREADS=${OPENBLAS_NUM_THREADS:-4}
export NUMEXPR_NUM_THREADS=${NUMEXPR_NUM_THREADS:-4}

# --- non-destructive XPU view of the A1 checkpoint (flash_attention_2 -> ATTN_IMPL,
#     vlm_name_or_path -> local Qwen so processor/config resolve offline) ---
CKPT_XPU=${CKPT}-xpu
python - "$CKPT" "$CKPT_XPU" "$QWEN_DIR" "$ATTN_IMPL" <<'PY'
import json, os, sys
src, dst, qwen, attn = sys.argv[1:5]
os.makedirs(dst, exist_ok=True)
for name in os.listdir(src):
    if name == "config.json":
        continue
    link = os.path.join(dst, name)
    if not os.path.lexists(link):
        os.symlink(os.path.join(src, name), link)
with open(os.path.join(src, "config.json")) as f:
    cfg = json.load(f)
cfg["attn_implementation"] = attn
cfg["vlm_name_or_path"] = qwen
with open(os.path.join(dst, "config.json"), "w") as f:
    json.dump(cfg, f, indent=2)
print(f"XPU checkpoint view ready ({attn}): {dst}")
PY
CKPT=${CKPT_XPU}

# CPU affinity for 12 tiles (2 sockets x 4 cores/rank).
CPU_BIND="verbose,list:4-7:8-11:12-15:16-19:20-23:24-27:56-59:60-63:64-67:68-71:72-75:76-79"
CPU_BIND_ARG=""
[ "${PPN}" = "12" ] && CPU_BIND_ARG="--cpu-bind=${CPU_BIND}"

MAXSTEPS_ARG=""
[ "${MAX_STEPS}" -gt 0 ] && MAXSTEPS_ARG="+trainer.max_steps=${MAX_STEPS}"

launch() {
  # shellcheck disable=SC2086
  mpiexec --pmi=pmix --envall -n "${NPROC}" -ppn "${PPN}" ${CPU_BIND_ARG} \
    "${VENV}/bin/python" -u scripts/aurora/alpamayo15_xpu_entry.py "$@"
}

STAGE1_OUT=${OUT_ROOT}/stage1
STAGE2_OUT=${OUT_ROOT}/stage2

if [ "${STAGE}" = "all" ] || [ "${STAGE}" = "1" ]; then
  echo "[$(date -u '+%FT%TZ')] === Stage 1: VLM SFT (nav+CoC, ZeRO-2, eff bs $((NPROC*BS1*ACCUM1)), ${EPOCHS1} epoch) ==="
  launch \
    --config-path pkg://alpamayo1_5_sft/configs --config-name sft_stage1_nav \
    vla_processor@data.train_dataset.vla_preprocess_args=nav_cot \
    vla_processor@data.val_dataset.vla_preprocess_args=nav_cot \
    data.train_dataset.local_dir="${PAI_DIR}" \
    data.val_dataset.local_dir="${PAI_DIR}" \
    data.train_dataset.annotations_path="${ANNOTATIONS}" \
    data.val_dataset.annotations_path="${ANNOTATIONS}" \
    data.train_dataset.chunk_ids="${TRAIN_CHUNKS}" \
    data.val_dataset.chunk_ids="${TRAIN_CHUNKS}" \
    data.train_dataset.vla_preprocess_args.generation_mode=false \
    data.val_dataset.vla_preprocess_args.generation_mode=true \
    model.checkpoint_path="${CKPT}" \
    model.vlm_name_or_path="${QWEN_DIR}" \
    paths.output_dir="${STAGE1_OUT}" \
    trainer.deepspeed="${DS_ZERO2}" \
    trainer.per_device_train_batch_size="${BS1}" \
    trainer.gradient_accumulation_steps="${ACCUM1}" \
    trainer.num_train_epochs="${EPOCHS1}" \
    trainer.warmup_steps="${WARMUP1}" \
    trainer.report_to="${REPORT_TO}" \
    +trainer.run_name=alpamayo15_carla_stage1 \
    +trainer.save_strategy="${SAVE_STRATEGY}" \
    trainer.save_steps="${SAVE_STEPS}" \
    trainer.logging_steps="${LOG_STEPS}" \
    trainer.save_total_limit=1 \
    ${MAXSTEPS_ARG} \
    hydra.output_subdir=null hydra.run.dir="${STAGE1_OUT}/hydra"
fi

if [ "${STAGE}" = "all" ] || [ "${STAGE}" = "2" ]; then
  STAGE1_CKPT=${STAGE1_CKPT:-$(ls -d "${STAGE1_OUT}"/checkpoint-* 2>/dev/null | sort -V | tail -1)}
  if [ -z "${STAGE1_CKPT}" ]; then
    echo "No stage-1 checkpoint under ${STAGE1_OUT}; run STAGE=1 first." >&2
    exit 3
  fi
  echo "[$(date -u '+%FT%TZ')] === Stage 2: traj expert (DDP, eff bs $((NPROC*BS2*ACCUM2)), ${EPOCHS2} epoch) using ${STAGE1_CKPT} ==="
  launch \
    --config-path pkg://alpamayo1_5_sft/configs --config-name sft_stage2_nav \
    data.train_dataset.local_dir="${PAI_DIR}" \
    data.val_dataset.local_dir="${PAI_DIR}" \
    data.train_dataset.annotations_path="${ANNOTATIONS}" \
    data.val_dataset.annotations_path="${ANNOTATIONS}" \
    data.train_dataset.chunk_ids="${TRAIN_CHUNKS}" \
    data.val_dataset.chunk_ids="${TRAIN_CHUNKS}" \
    data.train_dataset.vla_preprocess_args.generation_mode=false \
    data.val_dataset.vla_preprocess_args.generation_mode=true \
    model.pretrained_model_name_or_path="${CKPT}" \
    model.stage1_vlm_checkpoint_path="${STAGE1_CKPT}" \
    paths.output_dir="${STAGE2_OUT}" \
    trainer.per_device_train_batch_size="${BS2}" \
    trainer.gradient_accumulation_steps="${ACCUM2}" \
    trainer.num_train_epochs="${EPOCHS2}" \
    trainer.report_to="${REPORT_TO}" \
    +trainer.run_name=alpamayo15_carla_stage2 \
    +trainer.save_strategy="${SAVE_STRATEGY}" \
    trainer.save_steps="${SAVE_STEPS}" \
    trainer.logging_steps="${LOG_STEPS}" \
    trainer.save_total_limit=1 \
    ${MAXSTEPS_ARG} \
    hydra.output_subdir=null hydra.run.dir="${STAGE2_OUT}/hydra"
fi

echo "[$(date -u '+%FT%TZ')] === Alpamayo 1.5 SFT done ==="
find "${OUT_ROOT}" -maxdepth 2 -name "checkpoint-*" -type d 2>/dev/null
