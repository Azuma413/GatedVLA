#!/bin/bash
#PBS -l select=1
#PBS -l walltime=1:00:00
#PBS -q debug
#PBS -A RobustViT
#PBS -l filesystems=home:flare
#PBS -j oe
#PBS -o logs/aurora_train_vlajepa_carla_venv.out

# Train VLA-JEPA on the CARLA (PAI->LeRobot) dataset on Aurora Intel XPU using the
# native `frameworks` module (torch 2.10+xpu) + a venv of the extra deps. The
# generic IPEX container cannot see Aurora's XPUs (driver mismatch), so we run
# natively. Short smoke by default; override via qsub -v.
#   qsub -v NPROC=12,PPN=12 scripts/aurora/train_vlajepa_carla_venv.pbs        # full: 3 epochs
#   qsub -v NPROC=2,MAX_STEPS=5 scripts/aurora/train_vlajepa_carla_venv.pbs    # smoke
# NB: no `set -u` (Aurora lmod init references unbound vars).
set -eo pipefail

REPO_DIR=${REPO_DIR:-/lus/flare/projects/RobustViT/hiratsuka/VLA4AD_Research}
VENV=${VENV:-${REPO_DIR}/outputs/vlajepa_venv}
NPROC=${NPROC:-1}          # total XPU ranks (tiles). 1 node has 12 tiles.
PPN=${PPN:-${NPROC}}       # ranks per node (<=12)
# The config trains for trainer.epochs and derives max_train_steps from the dataset.
# Set MAX_STEPS to cap it instead (smoke tests): that also disables epoch mode.
MAX_STEPS=${MAX_STEPS:-}
EPOCHS=${EPOCHS:-}                                  # override config trainer.epochs
SAVE_INTERVAL=${SAVE_INTERVAL:-1000}
WARMUP=${WARMUP:-500}                               # smoke: 0; full: 500 (paper)
BS=${BS:-10}                                        # x12 tiles x GRAD_ACCUM = global batch
GRAD_ACCUM=${GRAD_ACCUM:-1}                         # optimizer step every N micro-batches
DATA_ROOT=${DATA_ROOT:-${REPO_DIR}/data/lerobot_256}   # 256^2 videos; data/lerobot is the 800x600 source
# Stage 1 (world-model pretrain, train_vjepa_video_carla_venv.pbs) output. Without it the
# CARLA-pretrained vj_predictor is thrown away and retrained from random init. Pass
# PRETRAINED_CKPT= (empty) to deliberately start from scratch.
PRETRAINED_CKPT=${PRETRAINED_CKPT-${REPO_DIR}/outputs/vlajepa_carla_video_full/carla_vjepa_pretrain/final_model/pytorch_model.pt}
CONFIG=${CONFIG:-scripts/config/vlajepa_carla_ft.yaml}

module use /soft/modulefiles
module load frameworks
# shellcheck disable=SC1091
source "${VENV}/bin/activate"

# W&B + HF credentials from repo .env (WANDB_API_KEY, HF_TOKEN).
if [ -f "${REPO_DIR}/.env" ]; then
  set -a
  # shellcheck disable=SC1091
  . "${REPO_DIR}/.env"
  set +a
fi
# Aurora compute nodes reach the internet only via the ALCF proxy — needed for
# online W&B. Override with WANDB_MODE=offline (qsub -v) + `wandb sync` if unreachable.
export https_proxy=${https_proxy:-http://proxy.alcf.anl.gov:3128}
export http_proxy=${http_proxy:-http://proxy.alcf.anl.gov:3128}

# Aurora XPU: autocast device, xccl-over-mpiexec bootstrap, offline HF.
export VLAJEPA_AMP_DEVICE=xpu
export VLAJEPA_XPU_MPI=1
export VLAJEPA_GRAD_ACCUM=${GRAD_ACCUM}
export HF_HUB_OFFLINE=1
export TRANSFORMERS_OFFLINE=1
export PYTHONUNBUFFERED=1
export PYTHONPATH="${REPO_DIR}/3rd_party/VLA-JEPA:${PYTHONPATH:-}"
# 12 ranks/node each spawn dataloader workers + BLAS threads; cap intra-op threads
# so they don't oversubscribe the cpu-bound cores (per multi-process Aurora lessons).
export OMP_NUM_THREADS=${OMP_NUM_THREADS:-4}
export MKL_NUM_THREADS=${MKL_NUM_THREADS:-4}
export OPENBLAS_NUM_THREADS=${OPENBLAS_NUM_THREADS:-4}
export NUMEXPR_NUM_THREADS=${NUMEXPR_NUM_THREADS:-4}

cd "${REPO_DIR}/3rd_party/VLA-JEPA"
mkdir -p "${REPO_DIR}/logs" "${REPO_DIR}/outputs/vlajepa_carla"

echo "[$(date -u '+%FT%TZ')] Training VLA-JEPA/CARLA (Aurora XPU, xccl) NPROC=${NPROC} PPN=${PPN} MAX_STEPS=${MAX_STEPS} BS=${BS}"

# Aurora distributed = mpiexec + xccl, per ALCF docs (data-science/frameworks/
# pytorch). --pmi=pmix is required for the oneCCL/xccl KVS; --envall propagates our
# env (VLAJEPA_XPU_MPI, PYTHONPATH, HF offline, venv) to every rank. train_starvla's
# VLAJEPA_XPU_MPI bootstrap derives rank/size via mpi4py and inits the xccl group;
# accelerate reuses it. Model/data paths override the yaml's container paths.
# CPU affinity (12 tiles, 2 sockets x 4 cores/rank) — only applied for the full node.
CPU_BIND="verbose,list:4-7:8-11:12-15:16-19:20-23:24-27:56-59:60-63:64-67:68-71:72-75:76-79"
CPU_BIND_ARG=""
[ "${PPN}" = "12" ] && CPU_BIND_ARG="--cpu-bind=${CPU_BIND}"

# Optional: initialize from the stage-1 (V-JEPA2 world-model pretrain) checkpoint.
# Full state_dict load (same VLA_JEPA arch), so the trained vj_predictor + QwenVL
# carry over and the action head is then trained on top.
PRETRAINED_ARG=""
if [ -n "${PRETRAINED_CKPT:-}" ]; then
  # A missing path would otherwise train from random init and only show up as a worse
  # policy hours later.
  [ -f "${PRETRAINED_CKPT}" ] || { echo "ERROR: PRETRAINED_CKPT not found: ${PRETRAINED_CKPT}" >&2; exit 1; }
  PRETRAINED_ARG="--trainer.pretrained_checkpoint=${PRETRAINED_CKPT}"
fi

# A fixed step budget overrides the config's epoch-derived one.
STEPS_ARG=""
[ -n "${MAX_STEPS}" ] && STEPS_ARG="--trainer.train_by_epochs=false --trainer.max_train_steps=${MAX_STEPS}"
[ -n "${EPOCHS}" ] && STEPS_ARG="${STEPS_ARG} --trainer.epochs=${EPOCHS}"

# shellcheck disable=SC2086
mpiexec --pmi=pmix --envall -n "${NPROC}" -ppn "${PPN}" ${CPU_BIND_ARG} \
  "${VENV}/bin/python" -u starVLA/training/train_starvla.py \
  --config_yaml "${CONFIG}" \
  --run_root_dir="${REPO_DIR}/outputs/vlajepa_carla" \
  --framework.qwenvl.base_vlm="${REPO_DIR}/outputs/models/Qwen3-VL-2B-Instruct" \
  --framework.vj2_model.base_encoder="${REPO_DIR}/outputs/models/vjepa2-vitl-fpc64-256" \
  --datasets.vla_data.data_root_dir="${DATA_ROOT}" \
  --datasets.vla_data.per_device_batch_size="${BS}" \
  ${PRETRAINED_ARG} \
  --trainer.gradient_accumulation_steps="${GRAD_ACCUM}" \
  ${STEPS_ARG} \
  --trainer.save_interval="${SAVE_INTERVAL}" \
  --trainer.num_warmup_steps="${WARMUP}"

echo "[$(date -u '+%FT%TZ')] === VLA-JEPA/CARLA training (Aurora XPU) done ==="
