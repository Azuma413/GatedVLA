#!/bin/bash
#PBS -l select=1
#PBS -l walltime=0:20:00
#PBS -q debug
#PBS -A RobustViT
#PBS -l filesystems=home:flare
#PBS -j oe
#PBS -o logs/aurora_diag_dist.out
set +e

REPO_DIR=${REPO_DIR:-/lus/flare/projects/RobustViT/hiratsuka/VLA4AD_Research}
VENV=${VENV:-${REPO_DIR}/outputs/vlajepa_venv}
module use /soft/modulefiles; module load frameworks
# shellcheck disable=SC1091
source "${VENV}/bin/activate"
cd "${REPO_DIR}"

export MASTER_ADDR=$(hostname)
export MASTER_PORT=29500
NRANKS=${NRANKS:-2}

cat > /tmp/dist_probe.py <<'PY'
import os, socket, torch
try:
    import intel_extension_for_pytorch as ipex  # noqa
except Exception as e:
    print("ipex import:", e)
from mpi4py import MPI

comm = MPI.COMM_WORLD
rank, world = comm.Get_rank(), comm.Get_size()
local = int(os.environ.get("PALS_LOCAL_RANKID", os.environ.get("MPI_LOCALRANKID", rank)))
master = comm.bcast(socket.gethostname() if rank == 0 else None, root=0)
os.environ["MASTER_ADDR"] = master
os.environ.setdefault("MASTER_PORT", "29500")
os.environ["RANK"] = str(rank); os.environ["WORLD_SIZE"] = str(world); os.environ["LOCAL_RANK"] = str(local)

if rank == 0:
    print(f"[env] world={world} xpu device_count={torch.xpu.device_count()} MASTER={master}")

torch.xpu.set_device(local)
backend = os.environ.get("DIST_BACKEND", "xccl")
print(f"[rank {rank}/{world}] local={local} init_process_group backend={backend} ...", flush=True)
torch.distributed.init_process_group(
    backend=backend, rank=rank, world_size=world,
    device_id=torch.device(f"xpu:{local}"),
)
t = torch.ones(4, device=f"xpu:{local}") * (rank + 1)
torch.distributed.all_reduce(t)
torch.distributed.barrier()
if rank == 0:
    print(f"[rank {rank}] all_reduce result={t.tolist()} (expect sum 1..{world} = {world*(world+1)//2}) OK", flush=True)
torch.distributed.destroy_process_group()
PY

echo "########## xccl backend ##########"
DIST_BACKEND=xccl mpiexec -n ${NRANKS} -ppn ${NRANKS} python /tmp/dist_probe.py 2>&1 | grep -viE 'Overriding a previously|dispatch key:|new kernel:|previous kernel:|operator: aten|Warning only once|_validate_compressed|ONEAPI_DEVICE_SELECTOR|Lmod|opencl:gpu|to enable Triton|support@alcf|revert|While processing|frameworks/2025|^ *---------|If you'
echo "xccl exit: $?"

echo "########## ccl backend ##########"
DIST_BACKEND=ccl mpiexec -n ${NRANKS} -ppn ${NRANKS} python /tmp/dist_probe.py 2>&1 | grep -viE 'Overriding a previously|dispatch key:|new kernel:|previous kernel:|operator: aten|Warning only once|_validate_compressed|ONEAPI_DEVICE_SELECTOR|Lmod|opencl:gpu|to enable Triton|support@alcf|revert|While processing|frameworks/2025|^ *---------|If you'
echo "ccl exit: $?"
echo "########## DONE ##########"
