#!/bin/sh
#PBS -l select=1
#PBS -l walltime=3:00:00
#PBS -q capacity
#PBS -A RobustViT
#PBS -l filesystems=home:flare
#PBS -j oe
#PBS -o logs/aurora_export_pai_full.out

# Convert ALL data/carla_alpamayo_4c_py123d/logs/carla_train clips (123D Arrow)
# to a single PAI-style dataset, using NUM_SHARDS parallel export processes on
# one Aurora compute node, then merging the shards.
#
# Single node only (queue `capacity`: 1-16 nodes, up to 168h). Serial export is
# ~26 s/clip (~33 h for 4566 clips); sharding cuts wall time to well under 1 h.
#
#   qsub scripts/aurora/export_pai_full.pbs
#   qsub -v NUM_SHARDS=64 scripts/aurora/export_pai_full.pbs
set -eu

REPO_DIR=${REPO_DIR:-/lus/flare/projects/RobustViT/hiratsuka/VLA4AD_Research}
LEAD_SIF=${LEAD_SIF:-${REPO_DIR}/containers/lead.sif}
LOGS_ROOT=${LOGS_ROOT:-data/carla_alpamayo_4c_py123d}
PAI_DIR=${PAI_DIR:-data/carla_alpamayo_pai}
SHARD_ROOT=${SHARD_ROOT:-data/carla_alpamayo_pai_shards}
NUM_SHARDS=${NUM_SHARDS:-48}
SPLIT=${SPLIT:-train}
MAX_LOGS=${MAX_LOGS:-0}   # 0 = all clips; >0 caps total for a small validation run

MAXLOGS_ARG=""
if [ "${MAX_LOGS}" != "0" ]; then
  MAXLOGS_ARG="--max-logs ${MAX_LOGS}"
fi

cd "${REPO_DIR}"
module use /soft/modulefiles || true
module load apptainer

mkdir -p logs "${SHARD_ROOT}"

# One thread per numeric library: each shard is a single-threaded process and we
# rely on running NUM_SHARDS of them in parallel for throughput.
THREAD_ENV="--env OPENBLAS_NUM_THREADS=1 --env OMP_NUM_THREADS=1 --env MKL_NUM_THREADS=1 --env NUMEXPR_NUM_THREADS=1"

echo "[$(date -u '+%FT%TZ')] Step 1: 123D -> PAI, ${NUM_SHARDS} parallel shards"

# Launch all shards inside ONE container as background processes; wait for all.
# A shard that fails leaves its shard dir without clip_index.parquet, which the
# merge step reports; re-running only that shard-index reproduces it.
# shellcheck disable=SC2086
apptainer exec ${THREAD_ENV} \
  -B "${REPO_DIR}:/workspace/VLA4AD_Research" \
  "${LEAD_SIF}" \
  bash -c '
    set -u
    NUM_SHARDS='"${NUM_SHARDS}"'
    fail=0
    for i in $(seq 0 $((NUM_SHARDS - 1))); do
      sdir=$(printf "'"${SHARD_ROOT}"'/shard_%04d" "$i")
      lead-python scripts/export_py123d_to_pai.py \
        --logs-root "'"${LOGS_ROOT}"'" \
        --output-dir "$sdir" \
        --split "'"${SPLIT}"'" \
        --num-shards "$NUM_SHARDS" \
        --shard-index "$i" \
        '"${MAXLOGS_ARG}"' \
        --overwrite \
        > "'"${SHARD_ROOT}"'/shard_$(printf %04d $i).log" 2>&1 &
    done
    wait
    echo "all shard processes exited"
  '

echo "[$(date -u '+%FT%TZ')] shard logs summary:"
grep -L "Done. Exported" "${SHARD_ROOT}"/shard_*.log 2>/dev/null | sed 's/^/  FAILED-OR-EMPTY: /' || true
grep -h "Done. Exported" "${SHARD_ROOT}"/shard_*.log 2>/dev/null | awk '{s+=$(NF-1)} END {print "  total clips reported by shards:", s}' || true

echo "[$(date -u '+%FT%TZ')] Step 2: merge shards -> ${PAI_DIR}"
# shellcheck disable=SC2086
apptainer exec ${THREAD_ENV} \
  -B "${REPO_DIR}:/workspace/VLA4AD_Research" \
  "${LEAD_SIF}" \
  lead-python scripts/merge_pai_shards.py \
    --shard-root "${SHARD_ROOT}" \
    --output-dir "${PAI_DIR}" \
    --num-shards "${NUM_SHARDS}" \
    --overwrite

echo "[$(date -u '+%FT%TZ')] === export done ==="
ls -la "${PAI_DIR}"
