#!/bin/bash
#PBS -l select=1
#PBS -l walltime=0:15:00
#PBS -q debug
#PBS -A RobustViT
#PBS -l filesystems=home:flare
#PBS -j oe
#PBS -o logs/aurora_extract_trajdata_pai.out
# One-off: copy trajdata's pai_dataset.py out of coc_autolabeler.sif so we can
# patch the SLERP interpolation (bad-clip) issue and bind-mount the fix back.
set -eo pipefail
REPO_DIR=${REPO_DIR:-/lus/flare/projects/RobustViT/hiratsuka/VLA4AD_Research}
WS=/workspace/VLA4AD_Research
module use /soft/modulefiles; module load apptainer
mkdir -p "${REPO_DIR}/scripts/aurora/_wa"
apptainer exec -B "${REPO_DIR}:${WS}" "${REPO_DIR}/containers/coc_autolabeler.sif" \
  bash -lc 'cp "$(python -c "import trajdata,os;print(os.path.join(os.path.dirname(trajdata.__file__),\"dataset_specific/pai/pai_dataset.py\"))")" '"${WS}"'/scripts/aurora/_wa/pai_dataset.orig.py && echo copied'
echo "=== extracted to scripts/aurora/_wa/pai_dataset.orig.py ==="
wc -l "${REPO_DIR}/scripts/aurora/_wa/pai_dataset.orig.py"
