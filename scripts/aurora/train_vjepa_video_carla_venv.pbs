#!/bin/bash
#PBS -l select=1
#PBS -l walltime=1:00:00
#PBS -q debug
#PBS -A RobustViT
#PBS -l filesystems=home:flare
#PBS -j oe
#PBS -o logs/aurora_train_vjepa_video_carla.out

# VLA-JEPA STAGE 1: V-JEPA2 world-model pretraining (video-only, wm_loss) on the
# CARLA video corpus, on Aurora Intel XPU via the native `frameworks` module +
# venv, mpiexec + xccl DDP. The frozen V-JEPA2 encoder + QwenVL produce features;
# the vj_predictor is trained to predict future V-JEPA2 embeddings (L1). Logs to W&B.
#   qsub -v NPROC=2,MAX_STEPS=40 scripts/aurora/train_vjepa_video_carla_venv.pbs
# NB: no `set -u` (Aurora lmod init references unbound vars).
set -eo pipefail

REPO_DIR=${REPO_DIR:-/lus/flare/projects/RobustViT/hiratsuka/VLA4AD_Research}
VENV=${VENV:-${REPO_DIR}/outputs/vlajepa_venv}
NPROC=${NPROC:-1}          # total XPU ranks (tiles). 1 node has 12 tiles.
PPN=${PPN:-${NPROC}}       # ranks per node (<=12)
MAX_STEPS=${MAX_STEPS:-40}
SAVE_INTERVAL=${SAVE_INTERVAL:-${MAX_STEPS}}   # smoke: save once at end; full: e.g. 5000
WARMUP=${WARMUP:-0}                            # smoke: 0; full: 500 (paper)
BS=${BS:-1}
CONFIG=${CONFIG:-scripts/config/vlajepa_carla_video.yaml}
RUN_ROOT=${RUN_ROOT:-${REPO_DIR}/outputs/vlajepa_carla_video}
VIDEO_DIR=${VIDEO_DIR:-${REPO_DIR}/data/vjepa_video/carla_smoke/clips}
TEXT_FILE=${TEXT_FILE:-${REPO_DIR}/data/vjepa_video/carla_smoke/instructions.csv}

module use /soft/modulefiles
module load frameworks
# shellcheck disable=SC1091
source "${VENV}/bin/activate"

# W&B + HF credentials from repo .env (WANDB_API_KEY, HF_TOKEN).
if [ -f "${REPO_DIR}/.env" ]; then
  set -a
  # shellcheck disable=SC1091
  . "${REPO_DIR}/.env"
  set +a
fi
# Aurora compute nodes reach the internet only via the ALCF proxy — needed for
# online W&B. If the proxy is unreachable, set WANDB_MODE=offline via qsub -v and
# `wandb sync` the run dir from a login node afterward.
export https_proxy=${https_proxy:-http://proxy.alcf.anl.gov:3128}
export http_proxy=${http_proxy:-http://proxy.alcf.anl.gov:3128}

# Aurora XPU: autocast device, xccl-over-mpiexec bootstrap, offline HF weights.
export VLAJEPA_AMP_DEVICE=xpu
export VLAJEPA_XPU_MPI=1
export HF_HUB_OFFLINE=1
export TRANSFORMERS_OFFLINE=1
export PYTHONUNBUFFERED=1
export PYTHONPATH="${REPO_DIR}/3rd_party/VLA-JEPA:${PYTHONPATH:-}"
# 12 ranks/node each spawn dataloader workers + BLAS threads; cap intra-op threads
# so they don't oversubscribe the cpu-bound cores (per multi-process Aurora lessons).
export OMP_NUM_THREADS=${OMP_NUM_THREADS:-4}
export MKL_NUM_THREADS=${MKL_NUM_THREADS:-4}
export OPENBLAS_NUM_THREADS=${OPENBLAS_NUM_THREADS:-4}
export NUMEXPR_NUM_THREADS=${NUMEXPR_NUM_THREADS:-4}

cd "${REPO_DIR}/3rd_party/VLA-JEPA"
mkdir -p "${REPO_DIR}/logs" "${RUN_ROOT}"

echo "[$(date -u '+%FT%TZ')] Stage1 V-JEPA2 pretrain (Aurora XPU, xccl) NPROC=${NPROC} PPN=${PPN} MAX_STEPS=${MAX_STEPS} BS=${BS}"
echo "[$(date -u '+%FT%TZ')] video_dir=${VIDEO_DIR}  wandb_mode=${WANDB_MODE:-online}"

CPU_BIND="verbose,list:4-7:8-11:12-15:16-19:20-23:24-27:56-59:60-63:64-67:68-71:72-75:76-79"
CPU_BIND_ARG=""
# cpu-bind pins each rank to 4 cores; good for compute locality but throttles the
# 16 dataloader workers/rank (data-I/O bound video decode). Set CPU_BIND_OFF=1 to
# let all ranks' workers share the node's cores.
[ "${PPN}" = "12" ] && [ "${CPU_BIND_OFF:-0}" != "1" ] && CPU_BIND_ARG="--cpu-bind=${CPU_BIND}"

# shellcheck disable=SC2086
mpiexec --pmi=pmix --envall -n "${NPROC}" -ppn "${PPN}" ${CPU_BIND_ARG} \
  "${VENV}/bin/python" -u starVLA/training/train_vlajepa_video.py \
  --config_yaml "${CONFIG}" \
  --run_root_dir="${RUN_ROOT}" \
  --framework.qwenvl.base_vlm="${REPO_DIR}/outputs/models/Qwen3-VL-2B-Instruct" \
  --framework.vj2_model.base_encoder="${REPO_DIR}/outputs/models/vjepa2-vitl-fpc64-256" \
  --datasets.video_data.video_dir="${VIDEO_DIR}" \
  --datasets.video_data.text_file="${TEXT_FILE}" \
  --datasets.video_data.per_device_batch_size="${BS}" \
  --trainer.max_train_steps="${MAX_STEPS}" \
  --trainer.save_interval="${SAVE_INTERVAL}" \
  --trainer.num_warmup_steps="${WARMUP}"

echo "[$(date -u '+%FT%TZ')] === Stage1 V-JEPA2 pretrain (Aurora XPU) done ==="
