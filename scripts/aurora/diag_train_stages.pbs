#!/bin/bash
#PBS -l select=1
#PBS -l walltime=0:30:00
#PBS -q debug
#PBS -A RobustViT
#PBS -l filesystems=home:flare
#PBS -j oe
#PBS -o logs/aurora_diag_train_stages.out
# no set -e: we want both stages to run even if the first crashes.
set +e

REPO_DIR=${REPO_DIR:-/lus/flare/projects/RobustViT/hiratsuka/VLA4AD_Research}
VENV=${VENV:-${REPO_DIR}/outputs/vlajepa_venv}
module use /soft/modulefiles; module load frameworks
# shellcheck disable=SC1091
source "${VENV}/bin/activate"
export VLAJEPA_AMP_DEVICE=xpu HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1
export PYTHONPATH="${REPO_DIR}/3rd_party/VLA-JEPA:${PYTHONPATH:-}"
cd "${REPO_DIR}/3rd_party/VLA-JEPA"
FILT='Overriding a previously|dispatch key:|new kernel:|previous kernel:|operator: aten|Warning only once|_validate_compressed_sparse'

echo "########## STAGE A: dataset fetch one sample ##########"
python - <<PY 2>&1 | grep -viE "$FILT"
from omegaconf import OmegaConf
from starVLA.dataloader.lerobot_datasets import get_vla_dataset
cfg = OmegaConf.load("scripts/config/vlajepa_carla_ft.yaml")
cfg.datasets.vla_data.data_root_dir = "${REPO_DIR}/data/lerobot"
ds = get_vla_dataset(cfg.datasets.vla_data, action_horizon=20, video_horizon=8, delete_pause_frame=False)
print("dataset len:", len(ds))
s = ds[0]
print("keys:", list(s.keys()))
print("action:", s["action"].shape, "video:", s["video"].shape, "n_images:", len(s["image"]), "lang:", s["lang"])
print("STAGE A OK")
PY
echo "stage A exit: $?"

echo "########## STAGE B: build model + move to xpu + one forward ##########"
python - <<PY 2>&1 | grep -viE "$FILT"
import torch
from omegaconf import OmegaConf
from starVLA.model.framework import build_framework
from starVLA.dataloader.lerobot_datasets import get_vla_dataset
cfg = OmegaConf.load("scripts/config/vlajepa_carla_ft.yaml")
cfg.framework.qwenvl.base_vlm = "${REPO_DIR}/outputs/models/Qwen3-VL-2B-Instruct"
cfg.framework.vj2_model.base_encoder = "${REPO_DIR}/outputs/models/vjepa2-vitl-fpc64-256"
cfg.datasets.vla_data.data_root_dir = "${REPO_DIR}/data/lerobot"
print("building framework...")
model = build_framework(cfg)
print("moving to xpu...")
model = model.to("xpu").train()
ds = get_vla_dataset(cfg.datasets.vla_data, action_horizon=20, video_horizon=8, delete_pause_frame=False)
batch = [ds[0]]
print("forward...")
with torch.autocast("xpu", dtype=torch.bfloat16):
    out = model.forward(batch)
print("losses:", {k: float(v) for k, v in out.items()})
print("STAGE B OK")
PY
echo "stage B exit: $?"
echo "########## DONE ##########"
