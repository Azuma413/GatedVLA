#!/bin/bash
#PBS -l select=1
#PBS -l walltime=1:00:00
#PBS -q debug
#PBS -A RobustViT
#PBS -l filesystems=home:flare
#PBS -j oe
#PBS -o /lus/flare/projects/RobustViT/hiratsuka/VLA4AD_Research/logs/train_qwendrive_pi.out

# QwenDrivePI (Qwen-Drive-1.0-4B + flow-matching expert) on PAI-AV front camera, Aurora XPU.
# frameworks module + venv, one rank per tile via mpiexec + xccl (torchrun/accelerate segfault with oneCCL),
# FSDP2 sharding, W&B online through the ALCF proxy, open-loop eval + BEV plots every trainer.eval_interval.
#
#   smoke (debug queue):  qsub -v MAX_STEPS=20,EVAL_INTERVAL=10,RUN_ID=qdpi_smoke examples/drive/PAI-AV/train_files/train_qwendrive_pi_aurora.pbs
#   full run:             qsub -q capacity -l walltime=24:00:00 -v TIME_LIMIT_HOURS=23.3 examples/drive/PAI-AV/train_files/train_qwendrive_pi_aurora.pbs
#                         (re-submit the same command to continue: training resumes from <run>/resume/latest
#                          and keeps logging into the same W&B run; TIME_LIMIT_HOURS saves + exits before walltime)
# Extra OmegaConf overrides: qsub -v EXTRA="trainer.learning_rate.base=3e-5 datasets.vla_data.per_device_batch_size=2"
# Training mode (one code base; picks the config unless CONFIG is given):
#   MODE=baseline        v2 layout (speed + target point in the prompt, AlpaSim state, accel/curvature actions)
#   MODE=eye             v2 + EyePolicy gate (budgeted soft mask); set PRETRAINED=<baseline checkpoint dir>
#   MODE=baseline_v3     v2 + VLM input [text, images] + DiT cross-attention on the visual tokens only
#   MODE=eye_v3          v3 structure + gate trained only by distillation to the ungated path; PRETRAINED=<ckpt>
#   MODE=eye_v4          v2 layout + gate with target-point query, distilled on the text-dropped path; PRETRAINED=<ckpt>
#   MODE=eye_v5          v2 layout + mask inside the VLM (from the image embeddings) + token removal path; PRETRAINED=<ckpt>
#   MODE=anchor_s1       AnchorVLA stage 1 (VLM + classifier), control-space anchors (v2 layout)
#   MODE=anchor_s2       AnchorVLA stage 2 (+ residual flow); PRETRAINED=<stage-1 checkpoint dir>
#   MODE=anchor_eye_s2   AnchorVLA stage 2 + eye gate;      PRETRAINED=<stage-1 checkpoint dir>
#   e.g. qsub -q capacity -l walltime=24:00:00 -v MODE=eye,PRETRAINED=<dir>,NUM_EPOCHS=3,RUN_ID=<id> <this file>
# Run qsub from lib/starVLA. Prereq (once): examples/drive/PAI-AV/prepare_paiav.py (norm stats + eval index).
# NB: no `set -u` (Aurora lmod init references unbound vars).
set -eo pipefail

REPO_DIR=${REPO_DIR:-/lus/flare/projects/RobustViT/hiratsuka/VLA4AD_Research}
STARVLA_DIR=${REPO_DIR}/lib/starVLA
VENV=${VENV:-/lus/flare/projects/RobustViT/hiratsuka/VLA4AD_Research/outputs/starvla_venv}
ENV_FILE=${ENV_FILE:-/lus/flare/projects/RobustViT/hiratsuka/.env}   # WANDB_API_KEY, HF_TOKEN
MODE=${MODE:-}
PRETRAINED=${PRETRAINED:-}
TF=examples/drive/PAI-AV/train_files
case "${MODE}" in
  "")            ;;
  baseline)      DEFAULT_CONFIG=${TF}/starvla_qwendrive_pi_paiav_v2_h25.yaml ;;
  eye)           DEFAULT_CONFIG=${TF}/starvla_qwendrive_pi_paiav_eye_v2_h25.yaml ;;
  baseline_v3)   DEFAULT_CONFIG=${TF}/starvla_qwendrive_pi_paiav_v3_h25.yaml ;;
  eye_v3)        DEFAULT_CONFIG=${TF}/starvla_qwendrive_pi_paiav_eye_v3_h25.yaml ;;
  eye_v4)        DEFAULT_CONFIG=${TF}/starvla_qwendrive_pi_paiav_eye_v4_h25.yaml ;;
  eye_v5)        DEFAULT_CONFIG=${TF}/starvla_qwendrive_pi_paiav_eye_v5_h25.yaml ;;
  anchor_s1)     DEFAULT_CONFIG=${TF}/starvla_qwendrive_pi_paiav_anchor_s1_v2_h25.yaml ;;
  anchor_s2)     DEFAULT_CONFIG=${TF}/starvla_qwendrive_pi_paiav_anchor_s2_v2_h25.yaml ;;
  anchor_eye_s2) DEFAULT_CONFIG=${TF}/starvla_qwendrive_pi_paiav_anchor_eye_s2_v2_h25.yaml ;;
  *) echo "unknown MODE=${MODE} (baseline | eye | baseline_v3 | eye_v3 | eye_v4 | eye_v5 | anchor_s1 | anchor_s2 | anchor_eye_s2)"; exit 2 ;;
esac
CONFIG=${CONFIG:-${DEFAULT_CONFIG:-${TF}/starvla_qwendrive_pi_paiav.yaml}}
NPROC=${NPROC:-12}
PPN=${PPN:-${NPROC}}
RUN_ID=${RUN_ID:-starvla_qwendrive_pi_paiav}
MAX_STEPS=${MAX_STEPS:-}
NUM_EPOCHS=${NUM_EPOCHS:-}     # epoch budget (overrides MAX_STEPS); 1 epoch = every train clip once at a random t0
EVAL_INTERVAL=${EVAL_INTERVAL:-}
SAVE_INTERVAL=${SAVE_INTERVAL:-}
TIME_LIMIT_HOURS=${TIME_LIMIT_HOURS:-}
EXTRA=${EXTRA:-}

module use /soft/modulefiles
module load frameworks
# shellcheck disable=SC1091
source "${VENV}/bin/activate"
if [ -f "${ENV_FILE}" ]; then
  set -a
  # shellcheck disable=SC1090
  . "${ENV_FILE}"
  set +a
fi
export https_proxy=${https_proxy:-http://proxy.alcf.anl.gov:3128}
export http_proxy=${http_proxy:-http://proxy.alcf.anl.gov:3128}
export WANDB__SERVICE_WAIT=${WANDB__SERVICE_WAIT:-300}
# Qwen-Drive weights are pre-fetched into this cache; compute nodes load offline.
export HF_HOME=${HF_HOME:-/lus/flare/projects/RobustViT/hiratsuka/tools/hf_home}
export HF_HUB_OFFLINE=1
export TRANSFORMERS_OFFLINE=1
export PYTHONUNBUFFERED=1
export PYTHONPATH="${STARVLA_DIR}:${PYTHONPATH:-}"
export OMP_NUM_THREADS=${OMP_NUM_THREADS:-4}
export MKL_NUM_THREADS=${MKL_NUM_THREADS:-4}

ARGS="run_id=${RUN_ID}"
[ -n "${MAX_STEPS}" ] && ARGS="${ARGS} trainer.max_train_steps=${MAX_STEPS}"
[ -n "${NUM_EPOCHS}" ] && ARGS="${ARGS} trainer.num_epochs=${NUM_EPOCHS}"
[ -n "${EVAL_INTERVAL}" ] && ARGS="${ARGS} trainer.eval_interval=${EVAL_INTERVAL}"
[ -n "${SAVE_INTERVAL}" ] && ARGS="${ARGS} trainer.save_interval=${SAVE_INTERVAL}"
[ -n "${TIME_LIMIT_HOURS}" ] && ARGS="${ARGS} trainer.time_limit_hours=${TIME_LIMIT_HOURS}"
[ -n "${PRETRAINED}" ] && ARGS="${ARGS} trainer.pretrained_checkpoint=${PRETRAINED}"
ARGS="${ARGS} ${EXTRA}"

# 12 ranks: 8 physical cores each (6 per socket) for the rank + its video-decoding dataloader workers.
CPU_BIND="list:1-8:9-16:17-24:25-32:33-40:41-48:53-60:61-68:69-76:77-84:85-92:93-100"
CPU_BIND_ARG=""
[ "${PPN}" = "12" ] && CPU_BIND_ARG="--cpu-bind=${CPU_BIND}"

cd "${STARVLA_DIR}"
mkdir -p "${REPO_DIR}/logs"
echo "[$(date -u '+%FT%TZ')] QwenDrivePI train NPROC=${NPROC} PPN=${PPN} ARGS=${ARGS}"
# shellcheck disable=SC2086
# PBS only copies -o at job end; tee a live log as well.
mpiexec --pmi=pmix --envall -n "${NPROC}" -ppn "${PPN}" ${CPU_BIND_ARG} \
  "${VENV}/bin/python" -u starVLA/training/train_drive.py --config "${CONFIG}" ${ARGS} \
  2>&1 | tee -a "${REPO_DIR}/logs/${RUN_ID}.log"
echo "[$(date -u '+%FT%TZ')] === QwenDrivePI training done ==="
