Bootstrap: docker
From: nvidia/cuda:12.8.1-cudnn-devel-ubuntu22.04

%labels
    Author VLA4AD_Research
    Description "LEAD Python 3.10 runtime for CARLA data collection on Polaris"

%files
    pyproject.toml /opt/build/lead/pyproject.toml

%environment
    export LEAD_PROJECT_ROOT=${LEAD_PROJECT_ROOT:-/workspace/VLA4AD_Research}
    export PY123D_DATA_ROOT=${PY123D_DATA_ROOT:-${LEAD_PROJECT_ROOT}/data/carla_alpamayo_4c_py123d}
    export CARLA_ROOT=${CARLA_ROOT:-${LEAD_PROJECT_ROOT}/3rd_party/CARLA_0915}
    export NVIDIA_DRIVER_CAPABILITIES=all
    export PYTHONNOUSERSITE=1
    export UV_LINK_MODE=copy
    export VIRTUAL_ENV=/opt/venvs/lead
    export PATH=/opt/venvs/lead/bin:/usr/local/bin:${LEAD_PROJECT_ROOT}/scripts:$PATH
    export PYTHONPATH=${LEAD_PROJECT_ROOT}:${LEAD_PROJECT_ROOT}/3rd_party/leaderboard_autopilot:${LEAD_PROJECT_ROOT}/3rd_party/scenario_runner_autopilot:${LEAD_PROJECT_ROOT}/3rd_party/leaderboard:${LEAD_PROJECT_ROOT}/3rd_party/scenario_runner:${LEAD_PROJECT_ROOT}/3rd_party/Bench2Drive/leaderboard:${LEAD_PROJECT_ROOT}/3rd_party/Bench2Drive/scenario_runner:${PYTHONPATH:-}

%post
    set -eux
    export DEBIAN_FRONTEND=noninteractive
    export UV_LINK_MODE=copy
    export UV_PYTHON_INSTALL_DIR=/opt/uv/python
    export PATH=/root/.local/bin:/opt/venvs/lead/bin:$PATH

    apt-get update
    apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        cmake \
        curl \
        ffmpeg \
        git \
        git-lfs \
        libegl1 \
        libffi-dev \
        libgl1 \
        libglib2.0-0 \
        libglvnd0 \
        libglx0 \
        libgomp1 \
        libsm6 \
        libssl-dev \
        libx11-6 \
        libxext6 \
        libxrender1 \
        net-tools \
        ninja-build \
        openssh-client \
        parallel \
        pciutils \
        pkg-config \
        procps \
        python3 \
        python3-pip \
        rsync \
        tree \
        unzip \
        wget \
        zip \
        zlib1g-dev
    rm -rf /var/lib/apt/lists/*

    curl -LsSf https://astral.sh/uv/install.sh | sh
    install -m 0755 /root/.local/bin/uv /usr/local/bin/uv
    uv python install 3.10

    uv venv --python 3.10 /opt/venvs/lead
    . /opt/venvs/lead/bin/activate
    cd /opt/build/lead
    uv sync --no-install-project --no-dev --active
    uv pip uninstall -y opencv-python || true
    uv pip install opencv-python-headless==4.10.0.84 --force-reinstall --no-deps
    python - <<'PY'
import carla
import torch
print("carla", getattr(carla, "__version__", "unknown"))
print("torch", torch.__version__)
PY
    rm -rf /root/.cache/uv
    chmod -R a+rwX /opt/venvs/lead /opt/build/lead

    cat >/usr/local/bin/lead-python <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
cd "${LEAD_PROJECT_ROOT:-/workspace/VLA4AD_Research}"
exec /opt/venvs/lead/bin/python "$@"
EOF

    cat >/usr/local/bin/lead-uv <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
cd "${LEAD_PROJECT_ROOT:-/workspace/VLA4AD_Research}"
VIRTUAL_ENV=/opt/venvs/lead exec /usr/local/bin/uv "$@"
EOF

    cat >/usr/local/bin/lead-shell <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
cd "${LEAD_PROJECT_ROOT:-/workspace/VLA4AD_Research}"
exec /bin/bash "$@"
EOF

    chmod +x /usr/local/bin/lead-python /usr/local/bin/lead-uv /usr/local/bin/lead-shell

%runscript
    exec /usr/local/bin/lead-shell "$@"

%test
    /opt/venvs/lead/bin/python - <<'PY'
import carla
import py123d
import torch
print("LEAD data-collection runtime OK")
PY

%help
    LEAD data-collection runtime image.

    Build on a Polaris compute node:
      apptainer build --fakeroot lead.sif lead.def

    Run from the repository root:
      apptainer exec --nv --writable-tmpfs -B "$PWD:/workspace/VLA4AD_Research" lead.sif \
        lead-python -m lead --expert --py123d --routes data/data_routes/lead/noScenarios/route_000391.xml
