Bootstrap: docker
From: nvidia/cuda:12.8.1-cudnn-devel-ubuntu22.04

%labels
    Author VLA4AD_Research
    Description "NVlabs CoC autolabeler runtime (trajdata + vLLM) for Polaris"

%files
    3rd_party/alpamayo-coc-autolabeler/requirements-lock.txt /opt/build/coc/requirements-lock.txt

%environment
    export COC_ROOT=${COC_ROOT:-/workspace/VLA4AD_Research/3rd_party/alpamayo-coc-autolabeler}
    export NVIDIA_DRIVER_CAPABILITIES=all
    export PYTHONNOUSERSITE=1
    # meta_action / coc_labeling sources are bind-mounted at runtime (like lead/alpamayo).
    export PYTHONPATH=${COC_ROOT}/src:${PYTHONPATH:-}

%post
    set -eux
    export DEBIAN_FRONTEND=noninteractive
    export TZ=America/Los_Angeles
    # ALCF proxy (passed in from build host via APPTAINERENV_*; default to ALCF proxy)
    export HTTP_PROXY=${HTTP_PROXY:-http://proxy.alcf.anl.gov:3128}
    export HTTPS_PROXY=${HTTPS_PROXY:-http://proxy.alcf.anl.gov:3128}
    export http_proxy=${http_proxy:-${HTTP_PROXY}}
    export https_proxy=${https_proxy:-${HTTPS_PROXY}}

    apt-get update
    apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        ffmpeg \
        git \
        git-lfs \
        libglib2.0-0 \
        libglm-dev \
        libopenmpi-dev \
        libsm6 \
        libxext6 \
        ninja-build \
        python3 \
        python3-dev \
        python3-pip \
        python-is-python3 \
        rsync \
        tzdata \
        unzip
    rm -rf /var/lib/apt/lists/*

    python -m pip install --upgrade pip

    # Mirror the autolabeler Dockerfile: install the locked runtime stack from the
    # CUDA 12.8 PyTorch wheel index (torch 2.10+cu128, vllm 0.17.1, transformers,
    # qwen-vl-utils, trajdata deps, etc.), then install trajdata's exact Git ref
    # outside the resolver (its declared protobuf pin conflicts with the rest).
    python -m pip install --no-cache-dir \
        --index-url https://download.pytorch.org/whl/cu128 \
        --extra-index-url https://pypi.org/simple \
        -r /opt/build/coc/requirements-lock.txt
    python -m pip install --no-cache-dir --no-deps \
        "trajdata @ git+https://github.com/NVlabs/trajdata.git@coc_autolabeling-1.0.0"

    # The lock ships BOTH opencv-python and opencv-python-headless, which share the
    # same `cv2` package dir. The non-headless build links libGL/libGLX; under
    # apptainer --nv the host-injected libGLX needs a newer glibc than this base
    # image (GLIBC_2.38) and breaks `import cv2` (trajdata imports cv2). Removing one
    # in-place corrupts the shared cv2 dir, so purge both and reinstall headless clean.
    python -m pip uninstall -y opencv-python opencv-python-headless
    python -m pip install --no-cache-dir opencv-python-headless==4.13.0.92
    python -c "import cv2; print('cv2 headless OK', cv2.__version__)"

    # Convenience launcher: run inside the bind-mounted autolabeler source tree so
    # hydra resolves config_path="config" from the package and PYTHONPATH picks up
    # both meta_action and coc_labeling.
    cat >/usr/local/bin/coc-python <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
export COC_ROOT="${COC_ROOT:-/workspace/VLA4AD_Research/3rd_party/alpamayo-coc-autolabeler}"
export PYTHONPATH="${COC_ROOT}/src:${PYTHONPATH:-}"
cd "${COC_ROOT}"
exec python "$@"
EOF
    chmod +x /usr/local/bin/coc-python

%runscript
    exec /bin/bash "$@"

%test
    python - <<'PY'
import torch
print("torch", torch.__version__, "cuda", torch.version.cuda)
import transformers, trajdata
print("transformers", transformers.__version__)
print("trajdata import OK")
try:
    import qwen_vl_utils  # noqa: F401
    print("qwen_vl_utils import OK")
except Exception as exc:  # pragma: no cover
    print("WARN qwen_vl_utils:", exc)
try:
    import vllm
    print("vllm", vllm.__version__)
except Exception as exc:  # pragma: no cover - vllm import may need runtime CUDA
    print("WARN vllm import (verify on a GPU node at runtime):", exc)
PY

%help
    NVlabs Chain-of-Causation (CoC) autolabeler runtime image.
    Source: 3rd_party/alpamayo-coc-autolabeler (bind-mounted at runtime).

    Build on a Polaris compute node:
      qsub scripts/polaris/build_coc_autolabeler.pbs

    Run (bind repo to /workspace/VLA4AD_Research):
      apptainer exec --nv -B "$PWD:/workspace/VLA4AD_Research" containers/coc_autolabeler.sif \
        coc-python -m meta_action.data_labeling --help
