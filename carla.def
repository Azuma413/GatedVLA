Bootstrap: docker
From: carlasim/carla:0.9.15

%labels
    Author VLA4AD_Research
    Description "CARLA 0.9.15 server runtime for Polaris/Apptainer"

%environment
    export CARLA_ROOT=/opt/carla
    export LANG=C.UTF-8
    export LC_ALL=C.UTF-8
    export NVIDIA_DRIVER_CAPABILITIES=all
    export SDL_AUDIODRIVER=dummy
    export __GLX_VENDOR_LIBRARY_NAME=nvidia
    export XDG_RUNTIME_DIR=${XDG_RUNTIME_DIR:-/tmp/xdg-runtime}
    export PATH=/opt/bin:$PATH
    export PYTHONPATH=/opt/carla/PythonAPI/carla:/opt/carla/PythonAPI/carla/agents:${PYTHONPATH:-}

%post
    set -eux
    export DEBIAN_FRONTEND=noninteractive

    apt-get update
    apt-get install -y --no-install-recommends \
        ca-certificates \
        locales \
        wget \
        xdg-utils \
        xdg-user-dirs
    rm -rf /var/lib/apt/lists/*
    locale-gen en_US.UTF-8 || true
    update-locale LANG=en_US.UTF-8 || true

    FOUND_SH=""
    if [ -x /opt/carla/CarlaUE4.sh ]; then
        FOUND_SH=/opt/carla/CarlaUE4.sh
    elif [ -x /home/carla/CarlaUE4.sh ]; then
        FOUND_SH=/home/carla/CarlaUE4.sh
    else
        FOUND_SH="$(find /opt /home -maxdepth 6 -type f -name CarlaUE4.sh 2>/dev/null | head -n 1 || true)"
    fi
    test -n "${FOUND_SH}"
    CARLA_DIR="$(dirname "${FOUND_SH}")"
    if [ "${CARLA_DIR}" != /opt/carla ]; then
        ln -sfnT "${CARLA_DIR}" /opt/carla
    fi
    chmod +x /opt/carla/CarlaUE4.sh || true
    sed -i '/chmod .*CarlaUE4-Linux-Shipping/d' /opt/carla/CarlaUE4.sh || true

    # Install AdditionalMaps (Town06, Town07, Town11, Town12, Town13, Town15).
    # These are needed for the majority of LEAD data collection routes.
    # Uses ALCF proxy during Apptainer build on compute nodes.
    # Set ADDITIONAL_MAPS_SKIP=1 in the host environment to skip this step.
    if [ "${ADDITIONAL_MAPS_SKIP:-0}" != "1" ]; then
        CARLA_VERSION=0.9.15
        # CARLA hosts AdditionalMaps on its release bucket (NOT github releases,
        # which 404). Overridable via ADDITIONAL_MAPS_URL.
        MAPS_URL="${ADDITIONAL_MAPS_URL:-https://carla-releases.s3.us-east-005.backblazeb2.com/Linux/AdditionalMaps_${CARLA_VERSION}.tar.gz}"
        MAPS_TAR="/tmp/AdditionalMaps_${CARLA_VERSION}.tar.gz"
        # Inherit proxy from host environment; fall back to ALCF proxy.
        export http_proxy="${http_proxy:-${HTTP_PROXY:-http://proxy.alcf.anl.gov:3128}}"
        export https_proxy="${https_proxy:-${http_proxy}}"
        export HTTP_PROXY="${http_proxy}"
        export HTTPS_PROXY="${https_proxy}"
        MAPS_OK=0
        if wget -q --tries=3 --timeout=300 -O "${MAPS_TAR}" "${MAPS_URL}" 2>/dev/null && [ -s "${MAPS_TAR}" ]; then
            MAPS_OK=1
        fi
        if [ "${MAPS_OK}" = "1" ]; then
            # Determine archive top-level: CARLA packages extract directly as CarlaUE4/...
            TOP=$(tar -tzf "${MAPS_TAR}" 2>/dev/null | head -1 | cut -d'/' -f1 || true)
            # --no-same-owner: under apptainer --fakeroot, restoring the
            # archive's uid/gid (1000) fails with EPERM and aborts the build.
            if [ "${TOP}" = "CarlaUE4" ]; then
                tar --no-same-owner -xzf "${MAPS_TAR}" -C "${CARLA_DIR}"
            else
                tar --no-same-owner -xzf "${MAPS_TAR}" -C "${CARLA_DIR}" --strip-components=1
            fi
            rm -f "${MAPS_TAR}"
            echo "AdditionalMaps installed to ${CARLA_DIR}"
            find "${CARLA_DIR}/CarlaUE4/Content/Carla/Maps" -maxdepth 1 -mindepth 1 -type d | sort || true
        else
            rm -f "${MAPS_TAR}"
            echo "WARNING: Could not download AdditionalMaps_${CARLA_VERSION}.tar.gz" >&2
            echo "  URL: ${MAPS_URL}" >&2
            echo "  Town06, Town07, Town15 etc. will be unavailable in this image." >&2
            echo "  Re-build with network access or pre-stage the file at ${MAPS_URL}." >&2
        fi
    else
        echo "Skipping AdditionalMaps (ADDITIONAL_MAPS_SKIP=1)"
    fi

    mkdir -p /opt/bin /tmp/xdg-runtime /opt/carla/CarlaUE4/Saved/Logs
    chmod -R a+rwX /tmp/xdg-runtime /opt/carla/CarlaUE4/Saved || true

    if ! command -v xdg-user-dir >/dev/null 2>&1; then
        cat >/opt/bin/xdg-user-dir <<'EOF'
#!/usr/bin/env bash
echo /tmp
EOF
        chmod +x /opt/bin/xdg-user-dir
    fi

    cat >/opt/bin/carla-server <<'EOF'
#!/usr/bin/env bash
set -euo pipefail

PORT="${CARLA_PORT:-${CARLA_RPC_PORT:-2000}}"
QUALITY="${CARLA_QUALITY:-Low}"
LOG_ARGS="${CARLA_LOG_ARGS--log -stdout -FullStdOutLogOutput}"
STDOUT_TEE="${CARLA_STDOUT_LOG:-0}"
USE_STDBUF="${CARLA_USE_STDBUF:-0}"

if [ -n "${CARLA_GRAPHICS_ADAPTER:-}" ]; then
    GRAPHICS_ADAPTER_VALUE="${CARLA_GRAPHICS_ADAPTER}"
elif [ -n "${CUDA_VISIBLE_DEVICES:-}" ] && [ "${CUDA_VISIBLE_DEVICES}" != "all" ]; then
    GRAPHICS_ADAPTER_VALUE="${CUDA_VISIBLE_DEVICES%%,*}"
    GRAPHICS_ADAPTER_VALUE="${GRAPHICS_ADAPTER_VALUE#gpu:}"
    case "${GRAPHICS_ADAPTER_VALUE}" in
        ''|*[!0-9]*) GRAPHICS_ADAPTER_VALUE="0" ;;
    esac
else
    GRAPHICS_ADAPTER_VALUE=""
fi

GRAPHICS_ADAPTER_ARGS=()
if [ -n "${GRAPHICS_ADAPTER_VALUE}" ]; then
    GRAPHICS_ADAPTER_ARGS=(-graphicsadapter="${GRAPHICS_ADAPTER_VALUE}")
fi

if [ "${CARLA_ARGS+x}" = "x" ]; then
    EXTRA_ARGS="${CARLA_ARGS}"
else
    RENDERER="${CARLA_RENDERER:-auto}"
    case "${RENDERER}" in
        vulkan) EXTRA_ARGS="-vulkan" ;;
        opengl) EXTRA_ARGS="-opengl" ;;
        none) EXTRA_ARGS="" ;;
        auto)
            if ls /etc/vulkan/icd.d/*.json >/dev/null 2>&1; then
                EXTRA_ARGS="-vulkan"
            else
                EXTRA_ARGS=""
            fi
            ;;
        *)
            echo "Unknown CARLA_RENDERER='${RENDERER}'. Use vulkan|opengl|none|auto." >&2
            exit 2
            ;;
    esac
fi

export VK_ICD_FILENAMES="${VK_ICD_FILENAMES:-/etc/vulkan/icd.d/nvidia_icd.json}"
export __GLX_VENDOR_LIBRARY_NAME="${__GLX_VENDOR_LIBRARY_NAME:-nvidia}"
export NVIDIA_DRIVER_CAPABILITIES="${NVIDIA_DRIVER_CAPABILITIES:-all}"
if [ -z "${SDL_VIDEODRIVER:-}" ]; then
    if [ -n "${DISPLAY:-}" ]; then
        export SDL_VIDEODRIVER=x11
    elif [ "${CARLA_HEADLESS:-0}" = "1" ]; then
        export SDL_VIDEODRIVER=offscreen
    fi
fi
export SDL_AUDIODRIVER="${SDL_AUDIODRIVER:-dummy}"

export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/tmp/xdg-runtime}"
mkdir -p "${XDG_RUNTIME_DIR}" || true
chmod 700 "${XDG_RUNTIME_DIR}" 2>/dev/null || true

CARLA_ROOT="${CARLA_ROOT:-/opt/carla}"
if [ ! -x "${CARLA_ROOT}/CarlaUE4.sh" ]; then
    FOUND_SH=""
    if [ -x /home/carla/CarlaUE4.sh ]; then
        FOUND_SH=/home/carla/CarlaUE4.sh
    elif [ -x /opt/carla/CarlaUE4.sh ]; then
        FOUND_SH=/opt/carla/CarlaUE4.sh
    else
        FOUND_SH="$(find /home /opt -maxdepth 6 -type f -name CarlaUE4.sh 2>/dev/null | head -n 1 || true)"
    fi
    if [ -n "${FOUND_SH}" ]; then
        CARLA_ROOT="$(dirname "${FOUND_SH}")"
    else
        echo "CarlaUE4.sh not found." >&2
        exit 1
    fi
fi

LOG_DIR="${CARLA_LOG_DIR:-${CARLA_ROOT}/CarlaUE4/Saved/Logs}"
mkdir -p "${LOG_DIR}" 2>/dev/null || true
LOG_STDOUT="${LOG_DIR}/carla-server.stdout.log"

cd "${CARLA_ROOT}"

set +e
HAS_GRAPHICS_ADAPTER=0
HAS_CARLA_RPC_PORT=0
HAS_RENDER_OFFSCREEN=0
HAS_NOSOUND=0
HAS_QUALITY_LEVEL=0
HAS_RENDERER=0
for arg in "$@"; do
    case "${arg}" in
        -graphicsadapter|-graphicsadapter=*) HAS_GRAPHICS_ADAPTER=1 ;;
        -carla-rpc-port|-carla-rpc-port=*) HAS_CARLA_RPC_PORT=1 ;;
        -RenderOffScreen) HAS_RENDER_OFFSCREEN=1 ;;
        -nosound) HAS_NOSOUND=1 ;;
        -quality-level|-quality-level=*) HAS_QUALITY_LEVEL=1 ;;
        -vulkan|-opengl) HAS_RENDERER=1 ;;
    esac
done

if [ $# -eq 0 ]; then
    CMD=(./CarlaUE4.sh -RenderOffScreen -nosound -quality-level="${QUALITY}" -carla-rpc-port="${PORT}" "${GRAPHICS_ADAPTER_ARGS[@]}" ${LOG_ARGS} ${EXTRA_ARGS})
else
    CMD=(./CarlaUE4.sh "$@")
    if [ "${HAS_RENDER_OFFSCREEN}" = "0" ]; then
        CMD+=(-RenderOffScreen)
    fi
    if [ "${HAS_NOSOUND}" = "0" ]; then
        CMD+=(-nosound)
    fi
    if [ "${HAS_QUALITY_LEVEL}" = "0" ]; then
        CMD+=(-quality-level="${QUALITY}")
    fi
    if [ "${HAS_CARLA_RPC_PORT}" = "0" ]; then
        CMD+=(-carla-rpc-port="${PORT}")
    fi
    if [ "${HAS_GRAPHICS_ADAPTER}" = "0" ]; then
        CMD+=("${GRAPHICS_ADAPTER_ARGS[@]}")
    fi
    if [ "${HAS_RENDERER}" = "0" ]; then
        CMD+=(${EXTRA_ARGS})
    fi
    CMD+=(${LOG_ARGS})
fi

if [ "${STDOUT_TEE}" = "1" ]; then
    if [ "${USE_STDBUF}" = "1" ] && command -v stdbuf >/dev/null 2>&1; then
        stdbuf -oL -eL "${CMD[@]}" 2>&1 | tee -a "${LOG_STDOUT}"
    else
        "${CMD[@]}" 2>&1 | tee -a "${LOG_STDOUT}"
    fi
    rc=${PIPESTATUS[0]}
else
    "${CMD[@]}"
    rc=$?
fi
set -e

if [ "${rc}" -ne 0 ]; then
    if [ -f "${LOG_DIR}/CarlaUE4.log" ]; then
        echo "---- CarlaUE4.log (tail) ----" >&2
        tail -n 200 "${LOG_DIR}/CarlaUE4.log" >&2 || true
    else
        echo "CarlaUE4.log not found at ${LOG_DIR}" >&2
        if [ -f "${LOG_STDOUT}" ]; then
            echo "---- carla-server.stdout.log (tail) ----" >&2
            tail -n 200 "${LOG_STDOUT}" >&2 || true
        fi
    fi
    exit "${rc}"
fi
EOF
    chmod +x /opt/bin/carla-server

%runscript
    exec /opt/bin/carla-server "$@"

%test
    test -x /opt/bin/carla-server
    test -x /opt/carla/CarlaUE4.sh

%help
    CARLA 0.9.15 runtime for Polaris.

    Build on a Polaris compute node:
      apptainer build --fakeroot carla.sif carla.def

    Run:
      apptainer run --nv --writable-tmpfs carla.sif

    Port override:
      CARLA_PORT=2002 apptainer run --nv --writable-tmpfs carla.sif
