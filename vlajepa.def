Bootstrap: docker
From: intel/intel-extension-for-pytorch:2.6.10-xpu

%labels
    Author VLA4AD_Research
    Description "VLA-JEPA training runtime for Aurora (Intel XPU). torch 2.6 XPU + IPEX."

%environment
    export VLAJEPA_ROOT=${VLAJEPA_ROOT:-/workspace/VLA4AD_Research/3rd_party/VLA-JEPA}
    export PYTHONNOUSERSITE=1
    # Aurora is Intel XPU: VLA-JEPA autocast device is switched from cuda to xpu.
    export VLAJEPA_AMP_DEVICE=xpu
    # Keep HF fully offline on compute nodes (weights are pre-downloaded).
    export HF_HUB_OFFLINE=${HF_HUB_OFFLINE:-1}
    export TRANSFORMERS_OFFLINE=${TRANSFORMERS_OFFLINE:-1}
    export PYTHONPATH=${VLAJEPA_ROOT}:${PYTHONPATH:-}

%post
    set -eux
    export DEBIAN_FRONTEND=noninteractive
    export HTTP_PROXY=${HTTP_PROXY:-http://proxy.alcf.anl.gov:3128}
    export HTTPS_PROXY=${HTTPS_PROXY:-http://proxy.alcf.anl.gov:3128}
    export http_proxy=${http_proxy:-${HTTP_PROXY}}
    export https_proxy=${https_proxy:-${HTTPS_PROXY}}

    apt-get update || true
    apt-get install -y --no-install-recommends \
        ffmpeg git git-lfs libgl1 libglib2.0-0 unzip wget || true
    rm -rf /var/lib/apt/lists/* || true

    # The base image ships torch/torchvision/ipex built for XPU. Do NOT reinstall
    # torch or torchvision (that would pull CPU wheels and break XPU). Install only
    # VLA-JEPA's Python deps, matching requirements.txt but excluding torch* and the
    # CUDA-only extras (flash-attn, pytorch3d, decord GPU variants).
    PIP="python -m pip"
    ${PIP} install --upgrade pip
    ${PIP} install \
        transformers==4.57.0 \
        accelerate==1.5.2 \
        deepspeed==0.16.9 \
        diffusers \
        timm \
        einops \
        qwen-vl-utils \
        transformers_stream_generator==0.0.4 \
        tiktoken \
        omegaconf \
        pydantic==2.10.6 \
        numpydantic==1.6.9 \
        numpy==1.26.4 \
        scipy \
        pillow \
        pyarrow==14.0.1 \
        fastparquet==2024.11.0 \
        av==12.3.0 \
        eva-decord==0.6.1 \
        albumentations==1.4.18 \
        tensorboard \
        matplotlib \
        rich \
        wandb \
        websocket-client==1.8.0 \
        websockets \
        msgpack \
        opencv-python-headless

    ${PIP} cache purge || true

    python - <<'PY'
import torch
print("torch", torch.__version__)
try:
    import intel_extension_for_pytorch as ipex
    print("ipex", ipex.__version__)
except Exception as e:
    print("ipex import failed:", e)
print("xpu available:", getattr(torch, "xpu", None) and torch.xpu.is_available())
import transformers, accelerate
print("transformers", transformers.__version__, "accelerate", accelerate.__version__)
PY

    cat >/usr/local/bin/vlajepa-python <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
cd "${VLAJEPA_ROOT:-/workspace/VLA4AD_Research/3rd_party/VLA-JEPA}"
exec python "$@"
EOF
    cat >/usr/local/bin/vlajepa-shell <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
cd "${VLAJEPA_ROOT:-/workspace/VLA4AD_Research/3rd_party/VLA-JEPA}"
exec /bin/bash "$@"
EOF
    chmod +x /usr/local/bin/vlajepa-python /usr/local/bin/vlajepa-shell

%runscript
    exec /usr/local/bin/vlajepa-shell "$@"

%test
    python - <<'PY'
import torch, transformers, accelerate
print("VLA-JEPA XPU runtime OK:", torch.__version__, transformers.__version__)
PY

%help
    VLA-JEPA training runtime for Aurora (Intel XPU).

    Build on an Aurora compute node:
      qsub scripts/aurora/build_vlajepa.pbs

    Run from the repository root (bind repo to /workspace/VLA4AD_Research):
      apptainer exec -B "$PWD:/workspace/VLA4AD_Research" containers/vlajepa.sif \
        vlajepa-python -m starVLA.training.train_starvla --config_yaml ...
